# Keep the Docker build context small and free of local state and secrets
.git
.gitignore
**/__pycache__
**/*.pyc
**/node_modules
venv
backend/mcp_server/venv
backend/.env
backend/static
backend/uploads
backend/*.db
backend/*.db-*
*.db
.env
frontend/.env
frontend/dist
logs
agent-logs
backup-files
test-script
api_java
user_flow_design_files
backend/user_flow_design_files
ssl
tempor
dxt
ioFlow_icons
docs
