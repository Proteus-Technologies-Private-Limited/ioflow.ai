# IOFlow Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# Agent Model Configuration
AGENT_MODEL=gemini-2.5-pro  # Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash

# API Keys (Replace with your actual keys)
IOFLOW_API_KEY=your_ioflow_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# IOFlow Backend Configuration
IOFLOW_BASE_URL=http://localhost:7001