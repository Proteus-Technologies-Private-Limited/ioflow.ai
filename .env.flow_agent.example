# Flow Design Agent Configuration
# IMPORTANT: Keep this file secure and never commit to version control

# IOFlow API Key (get from IOFlow UI > Settings > API Keys)
IOFLOW_API_KEY=your_ioflow_api_key_here

# Google API Key for Gemini models
GOOGLE_API_KEY=your_google_api_key_here

# IOFlow Backend URL
IOFLOW_BASE_URL=http://localhost:7001

# Model to use (optional, defaults to gemini-2.0-flash-exp)
FLOW_DESIGN_MODEL=gemini-2.5-flash