# Application Settings
APP_NAME="IOFlow"
APP_URL="http://localhost:3000"
API_URL="http://localhost:7001"

# Database Configuration
DATABASE_URL="postgresql://ioflow:password@localhost:5432/ioflow"
REDIS_URL="redis://localhost:6379"

# Security
SECRET_KEY="your-secret-key-here-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY="your-encryption-key-here-32-chars"

# OAuth2 Settings
OAUTH_CALLBACK_BASE_URL="http://localhost:7001/api/v1/oauth2/callback"
OAUTH_STATE_TTL_MINUTES=15
OAUTH_POPUP_ENABLED=true
OAUTH_CLEANUP_INTERVAL_MINUTES=60

# Email Configuration (Postmark)
POSTMARK_API_KEY="your-postmark-api-key"
FROM_EMAIL="noreply@ioflow.com"

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Razorpay Configuration
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"