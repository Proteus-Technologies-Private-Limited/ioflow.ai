# Application Settings
APP_NAME="IOFlow"
# Public URL of this IOFlow server. Used in webhook URLs, OAuth callbacks and
# links in emails. Change these together when not running on localhost.
APP_URL="http://localhost:7001"
API_URL="http://localhost:7001"
SERVER_URL="http://localhost:7001"
BASE_URL="http://localhost:7001"
# Comma-separated extra origins allowed to call the API (CORS). Leave empty
# when the UI is served by the backend itself.
ALLOWED_ORIGINS=""

# Database Configuration
# Matches `docker compose up -d postgres redis` (PostgreSQL on host port 5433).
# With your own PostgreSQL whose user is not named "ioflow", append
# ?options=-csearch_path%3Dioflow to the URL.
DATABASE_URL="postgresql://ioflow:ioflow_local_pass@localhost:5433/ioflow"
REDIS_URL="redis://localhost:6379"

# Security
# Leave SECRET_KEY and ENCRYPTION_KEY empty: ./start_backend.sh generates both
# on first start and writes them into your .env. Keep them afterwards.
# ENCRYPTION_KEY protects stored credentials and must be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=""

# OAuth2 Settings
OAUTH_CALLBACK_BASE_URL="http://localhost:7001/api/v1/oauth2/callback"
OAUTH_STATE_TTL_MINUTES=15
OAUTH_POPUP_ENABLED=true
OAUTH_CLEANUP_INTERVAL_MINUTES=60

# Email Configuration (Postmark)
POSTMARK_API_KEY="your-postmark-api-key"
FROM_EMAIL="noreply@ioflow.com"

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Razorpay Configuration
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
