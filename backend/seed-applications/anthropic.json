{
  "key": "anthropic",
  "application": {
    "app_name": "Anthropic (Claude)",
    "app_type": "api",
    "app_scope": "tenant",
    "description": "Claude models through the Anthropic API — ask, classify and extract with guaranteed-JSON structured output, count tokens, and run large jobs as half-price message batches.",
    "category": "AI/ML",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "x-api-key",
      "header_prefix": "",
      "description": "Anthropic API key (console.anthropic.com → API keys)"
    },
    "version": "1.1.0",
    "base_url": "https://api.anthropic.com/v1",
    "icon_url": "https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/anthropic.svg",
    "configuration_schema": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API Key",
          "description": "Your Anthropic API key",
          "encrypted": true,
          "required": true
        }
      }
    }
  },
  "events": [],
  "services": [
    {
      "service_name": "create_message",
      "display_name": "Create Message",
      "service_type": "api_call",
      "description": "Send a conversation to Claude (POST /v1/messages) with full control: system prompt, messages, tools, structured output and effort. Read the text from content[] blocks of type \"text\".",
      "endpoint_template": "/messages",
      "request_config": {
        "method": "POST",
        "parameter_method": "json_payload",
        "headers": {
          "anthropic-version": "2026-10-21",
          "Content-Type": "application/json",
          "anthropic-beta": "server-side-fallback-2026-07-01"
        },
        "body_template": {
          "model": "{{model}}",
          "max_tokens": "{{max_tokens}}",
          "system": "{{system}}",
          "messages": "{{messages}}",
          "stop_sequences": "{{stop_sequences}}",
          "tools": "{{tools}}",
          "tool_choice": "{{tool_choice}}",
          "output_config": "{{output_config}}",
          "thinking": "{{thinking}}",
          "metadata": "{{metadata}}",
          "fallbacks": "{{fallbacks}}"
        }
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.type",
          "message_field": "error.message"
        },
        "usage": {
          "currency": "USD",
          "price_note": "Anthropic list prices per million tokens (Oct 2026), by the model that answered: Opus 5.5 $4 in / $20 out, Sonnet 5.5 $2 / $10, Haiku 5.5 $0.10 / $0.50 (prompts over 100K tokens cost more), Fable 5.1 $10 / $50; cache reads $0.20 (Opus, Sonnet), $0.25 (Fable). Thinking is billed as output. A model or cache write with no list price here is shown as unpriced.",
          "meters": [
            {
              "meter": "input_tokens",
              "label": "Input tokens",
              "unit": "token",
              "value": "usage.input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 4.0,
                  "claude-sonnet-5-5": 2.0,
                  "claude-haiku-5-5": 0.1,
                  "claude-fable-5-1": 10.0
                }
              }
            },
            {
              "meter": "output_tokens",
              "label": "Output tokens",
              "unit": "token",
              "value": "usage.output_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 20.0,
                  "claude-sonnet-5-5": 10.0,
                  "claude-haiku-5-5": 0.5,
                  "claude-fable-5-1": 50.0
                }
              }
            },
            {
              "meter": "cache_read_tokens",
              "label": "Cached input read",
              "unit": "token",
              "value": "usage.cache_read_input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 0.2,
                  "claude-sonnet-5-5": 0.2,
                  "claude-fable-5-1": 0.25
                }
              }
            },
            {
              "meter": "cache_write_tokens",
              "label": "Cached input written",
              "unit": "token",
              "value": "usage.cache_creation_input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {}
              }
            }
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "claude-opus-5-5",
              "claude-sonnet-5-5",
              "claude-haiku-5-5",
              "claude-fable-5-1"
            ],
            "default": "claude-opus-5-5",
            "description": "Claude model. claude-opus-5-5 (default) for the best judgement; claude-haiku-5-5 is far cheaper for high-volume classification; claude-sonnet-5-5 sits between them."
          },
          "max_tokens": {
            "type": "integer",
            "default": 16000,
            "description": "Maximum tokens to generate"
          },
          "system": {
            "type": "string",
            "description": "System prompt: the instructions, categories and output rules"
          },
          "messages": {
            "type": "array",
            "description": "Conversation turns [{role: user|assistant, content: string | content blocks}]",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {}
              },
              "required": [
                "role",
                "content"
              ]
            }
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "description": "Tool definitions [{name, description, input_schema, strict?}]"
          },
          "tool_choice": {
            "type": "object",
            "description": "{\"type\": \"auto\"} or {\"type\": \"none\"}"
          },
          "output_config": {
            "type": "object",
            "description": "{\"effort\": \"low\"} and/or structured output {\"format\": {\"type\": \"json_schema\", \"schema\": {…}}}"
          },
          "thinking": {
            "type": "object",
            "description": "{\"type\": \"adaptive\", \"display\": \"summarized\"} to see a reasoning summary"
          },
          "metadata": {
            "type": "object",
            "description": "{\"user_id\": \"…\"} — an opaque id for abuse monitoring"
          },
          "fallbacks": {
            "type": "string",
            "enum": [
              "default"
            ],
            "description": "Set to \"default\" so a request a safety classifier declines is retried on a fallback model by the API (Opus / Sonnet / Fable models; leave unset for Haiku). Check stop_reason == \"refusal\" in the response."
          }
        },
        "required": [
          "model",
          "max_tokens",
          "messages"
        ]
      },
      "sample_input": {
        "model": "claude-opus-5-5",
        "max_tokens": 1024,
        "fallbacks": "default",
        "messages": [
          {
            "role": "user",
            "content": "Summarise this complaint in one line: ..."
          }
        ]
      },
      "sample_output": {
        "id": "msg_01XFDUDYJgAACzvnptvVoYEL",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5-5",
        "content": [
          {
            "type": "text",
            "text": "{\"results\": [{\"id\": \"1\", \"sentiment\": \"negative\", \"category\": \"Failed transaction\", \"state\": \"Maharashtra\"}]}"
          }
        ],
        "stop_reason": "end_turn",
        "usage": {
          "input_tokens": 812,
          "output_tokens": 64
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "stop_reason": {
            "type": "string",
            "description": "end_turn | max_tokens | stop_sequence | tool_use | refusal | pause_turn"
          },
          "content": {
            "type": "array",
            "description": "Content blocks. Read the block(s) with type \"text\"; thinking blocks (type \"thinking\") may precede them.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "timeout_seconds": 300
    },
