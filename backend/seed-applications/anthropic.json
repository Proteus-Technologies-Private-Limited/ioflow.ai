                  "category",
                  "state"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sentiment": {
                    "type": "string",
                    "enum": [
                      "negative",
                      "neutral",
                      "positive"
                    ]
                  },
                  "category": {
                    "type": "string"
                  },
                  "state": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "model": "claude-opus-5-5",
        "max_tokens": 8000,
        "effort": "low",
        "fallbacks": "default"
      },
      "sample_output": {
        "id": "msg_01XFDUDYJgAACzvnptvVoYEL",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5-5",
