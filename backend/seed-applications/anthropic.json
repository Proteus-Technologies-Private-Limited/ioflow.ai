    {
      "service_name": "extract_structured",
      "display_name": "Extract Structured Data (JSON)",
      "service_type": "api_call",
      "description": "Process records into JSON that is guaranteed to match json_schema (structured output) — the step for classifying or extracting a BATCH: put the instructions and allowed categories in system, the records (e.g. a JSON array of {id, text, location}) in prompt, and a schema such as {\"type\":\"object\",\"properties\":{\"results\":{\"type\":\"array\",\"items\":{…}}},\"required\":[\"results\"],\"additionalProperties\":false}. Parse the text block of content[] with json.loads in the next transform. Keep ids in the output to join back.",
      "endpoint_template": "/messages",
      "request_config": {
        "method": "POST",
        "parameter_method": "json_payload",
        "headers": {
          "anthropic-version": "2026-10-21",
          "Content-Type": "application/json",
          "anthropic-beta": "server-side-fallback-2026-07-01"
        },
        "body_template": {
          "model": "{{model}}",
          "max_tokens": "{{max_tokens}}",
          "system": "{{system}}",
          "messages": [
            {
              "role": "user",
              "content": "{{prompt}}"
            }
          ],
          "output_config": {
            "effort": "{{effort}}",
            "format": {
              "type": "json_schema",
              "schema": "{{json_schema}}"
            }
          },
          "fallbacks": "{{fallbacks}}"
        }
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.type",
          "message_field": "error.message"
        },
        "usage": {
          "currency": "USD",
          "price_note": "Anthropic list prices per million tokens (Oct 2026), by the model that answered: Opus 5.5 $4 in / $20 out, Sonnet 5.5 $2 / $10, Haiku 5.5 $0.10 / $0.50 (prompts over 100K tokens cost more), Fable 5.1 $10 / $50; cache reads $0.20 (Opus, Sonnet), $0.25 (Fable). Thinking is billed as output. A model or cache write with no list price here is shown as unpriced.",
          "meters": [
            {
              "meter": "input_tokens",
              "label": "Input tokens",
              "unit": "token",
              "value": "usage.input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 4.0,
                  "claude-sonnet-5-5": 2.0,
                  "claude-haiku-5-5": 0.1,
                  "claude-fable-5-1": 10.0
                }
              }
            },
            {
              "meter": "output_tokens",
              "label": "Output tokens",
              "unit": "token",
              "value": "usage.output_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 20.0,
                  "claude-sonnet-5-5": 10.0,
                  "claude-haiku-5-5": 0.5,
                  "claude-fable-5-1": 50.0
                }
              }
            },
            {
              "meter": "cache_read_tokens",
              "label": "Cached input read",
              "unit": "token",
              "value": "usage.cache_read_input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {
                  "claude-opus-5-5": 0.2,
                  "claude-sonnet-5-5": 0.2,
                  "claude-fable-5-1": 0.25
                }
              }
            },
            {
              "meter": "cache_write_tokens",
              "label": "Cached input written",
              "unit": "token",
              "value": "usage.cache_creation_input_tokens",
              "dimension_path": "model",
              "price": {
                "per": 1000000,
                "by": {}
              }
            }
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The records to process (text, or a JSON array as a string)"
          },
          "json_schema": {
            "type": "object",
            "description": "JSON Schema the answer must match. Objects need \"additionalProperties\": false and a \"required\" list."
          },
          "system": {
            "type": "string",
            "description": "System prompt: the instructions, categories and output rules"
          },
          "model": {
            "type": "string",
            "enum": [
              "claude-opus-5-5",
              "claude-sonnet-5-5",
              "claude-haiku-5-5",
              "claude-fable-5-1"
            ],
            "default": "claude-opus-5-5",
            "description": "Claude model. claude-opus-5-5 (default) for the best judgement; claude-haiku-5-5 is far cheaper for high-volume classification; claude-sonnet-5-5 sits between them."
          },
          "max_tokens": {
            "type": "integer",
            "default": 16000,
            "description": "Maximum tokens to generate — allow ~60 per classified record"
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "How much the model thinks before answering. low suits classification and extraction at volume; omit for the model's default."
          },
          "fallbacks": {
            "type": "string",
            "enum": [
              "default"
            ],
            "description": "Set to \"default\" so a request a safety classifier declines is retried on a fallback model by the API (Opus / Sonnet / Fable models; leave unset for Haiku). Check stop_reason == \"refusal\" in the response."
          }
        },
        "required": [
          "prompt",
          "json_schema",
          "model",
          "max_tokens"
        ]
      },
      "sample_input": {
        "system": "Classify each tweet addressed to an Indian bank or regulator. sentiment: negative|neutral|positive. category: one of Failed transaction, Card issue, Loan, KYC, Fraud, Customer service, Charges, Other. state: the Indian state from the author's location, or null if unknown.",
        "prompt": "[{\"id\": \"1\", \"text\": \"@RBI my UPI refund is pending 10 days\", \"location\": \"Pune\"}]",
        "json_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "results"
          ],
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
