            "type": "string",
            "description": "Task GID"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "due_on": {
            "type": "string",
            "format": "date"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "required": [
          "task_gid"
        ]
      }
    },
