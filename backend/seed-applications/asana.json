  "services": [
    {
      "service_name": "create_task",
      "display_name": "Create Task",
      "description": "Creates a new task in Asana",
      "service_type": "api_call",
      "endpoint_template": "/tasks",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json"
        }
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            201
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Task name"
          },
          "notes": {
            "type": "string",
            "description": "Task notes"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of project IDs"
          },
          "assignee": {
            "type": "string",
            "description": "User ID to assign"
          },
          "due_on": {
            "type": "string",
            "format": "date",
            "description": "Due date (YYYY-MM-DD)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "service_name": "get_task",
      "display_name": "Get Task",
      "description": "Retrieves a task by ID",
      "service_type": "api_call",
      "endpoint_template": "/tasks/{{task_gid}}",
      "request_config": {
        "method": "GET"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "task_gid": {
            "type": "string",
            "description": "Task GID"
          },
          "opt_fields": {
            "type": "string",
            "description": "Comma-separated optional fields to include"
          }
        },
        "required": [
          "task_gid"
        ]
      }
    },
    {
      "service_name": "update_task",
      "display_name": "Update Task",
      "description": "Updates fields on a task",
      "service_type": "api_call",
      "endpoint_template": "/tasks/{{task_gid}}",
      "request_config": {
        "method": "PUT",
        "headers_template": {
          "Content-Type": "application/json"
        },
        "body_template": {
          "data": {
            "name": "{{name}}",
            "notes": "{{notes}}",
            "assignee": "{{assignee}}",
            "due_on": "{{due_on}}",
            "completed": "{{completed}}"
          }
        }
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
