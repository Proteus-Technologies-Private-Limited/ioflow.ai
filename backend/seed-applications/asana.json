{
  "key": "asana",
  "application": {
    "app_name": "Asana",
    "app_type": "api",
    "category": "Integration",
    "auth_type": "oauth2",
    "description": "Work management platform to organize tasks, projects, and teams",
    "base_url": "https://app.asana.com/api/1.0",
    "version": "1.0.16",
    "auth_config": {
