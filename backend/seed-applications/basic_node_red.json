{
  "key": "basic_node_red",
  "application": {
    "app_name": "Basic Node Red",
    "app_type": "api",
    "description": "Node-RED Application with custom API endpoints",
    "category": "Automation",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "Authorization",
      "query_param": null,
      "header_prefix": "Bearer"
