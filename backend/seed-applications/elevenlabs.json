    {
      "service_name": "get_history",
      "description": "Retrieve generation history with filtering by voice, model, date range, and source",
      "service_type": "api_call",
      "endpoint_template": "/v1/history",
      "request_config": {
        "method": "GET"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "page_size": {
            "type": "integer",
            "description": "Max items to return (max 1000, default 100)",
            "default": 100
          },
          "start_after_history_item_id": {
            "type": "string",
            "description": "Cursor for pagination"
          },
          "voice_id": {
            "type": "string",
            "description": "Filter by voice ID"
          },
          "model_id": {
            "type": "string",
            "description": "Filter by model ID"
          },
          "date_before_unix": {
            "type": "integer",
            "description": "Filter items before this Unix timestamp (exclusive)"
          },
          "date_after_unix": {
            "type": "integer",
            "description": "Filter items after this Unix timestamp (inclusive)"
          },
          "sort_direction": {
            "type": "string",
            "description": "Sort order",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "search": {
            "type": "string",
            "description": "Text-based search filter"
          },
          "source": {
            "type": "string",
            "description": "Filter by source type",
            "enum": [
              "TTS",
              "STS",
              "Projects",
              "PD",
              "AN",
              "Dubbing",
              "PlayAPI",
              "ConvAI",
              "VoiceGeneration"
            ]
          }
        },
        "required": []
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
