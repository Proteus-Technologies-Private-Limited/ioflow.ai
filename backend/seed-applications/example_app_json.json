{
  "key": "example_app_json",
  "application": {
    "app_name": "Example JSON Application",
    "app_type": "api",
    "description": "Example application to show JSON structure",
    "category": "Development",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "X-API-Key",
      "query_param": null
    },
    "version": "1.1.0",
    "base_url": "https://api.example.com",
    "icon_url": "https://example.com/example_app_json-icon.png",
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "create_user",
      "display_name": "Create User",
      "description": "Create a new user in the system",
      "service_type": "api_call",
      "request_config": {
        "parameter_method": "body",
        "headers_template": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-API-Key": "{{auth.api_key}}"
        },
        "body_template": {
          "name": "{{name}}",
          "email": "{{email}}",
          "role": "{{role}}"
        },
        "method": "POST"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "User's full name"
          },
          "email": {
            "type": "string",
            "description": "User's email address",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "User's role in the system",
            "default": "user",
            "enum": [
              "admin",
              "user",
              "guest"
            ]
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "User ID"
          },
          "name": {
            "type": "string",
            "description": "User's full name"
          },
          "email": {
            "type": "string",
            "description": "User's email address"
          },
          "role": {
            "type": "string",
            "description": "User's role"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          }
        }
      },
      "response_config": {
        "data_path": "$.data",
        "error_path": "$.error"
      },
      "sample_input": {
        "name": "John Doe",
        "email": "john.doe@example.com",
        "role": "user"
      },
      "sample_output": {
        "id": 123,
        "name": "John Doe",
        "email": "john.doe@example.com",
        "role": "user",
        "created_at": "2025-07-27T13:30:00Z"
      },
      "is_async": false,
      "timeout_seconds": 30,
      "endpoint_template": "{{base_url}}/users"
    }
  ],
  "events": [
    {
      "event_name": "payment_completed",
      "display_name": "Payment Completed",
      "description": "Triggered when a payment is successfully completed",
      "event_type": "webhook",
      "event_configuration": {
        "webhook_url": "/webhooks/payment-completed",
        "http_method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "X-Webhook-Secret": "webhook_secret"
        },
        "retry_config": {
          "max_retries": 3,
          "retry_delay_seconds": 5
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "description": "Type of event"
          },
          "payment_id": {
            "type": "string",
            "description": "Payment identifier"
          },
          "amount": {
            "type": "number",
            "description": "Payment amount"
          },
          "currency": {
            "type": "string",
            "description": "Currency code"
          },
          "user_id": {
            "type": "integer",
            "description": "User ID"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Event timestamp"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "Order identifier"
              },
              "product": {
                "type": "string",
                "description": "Product name"
              }
            }
          }
        }
      },
      "sample_payload": {
        "event_type": "payment.completed",
        "payment_id": "pay_123456",
        "amount": 99.99,
        "currency": "USD",
        "user_id": 123,
        "timestamp": "2025-07-27T13:30:00Z",
        "metadata": {
          "order_id": "ord_789",
          "product": "Premium Plan"
        }
      }
    }
  ],
  "metadata": {
    "created_at": "2025-07-27T13:29:07.097986",
    "created_by": "IOFlow",
    "author": "IOFlow",
