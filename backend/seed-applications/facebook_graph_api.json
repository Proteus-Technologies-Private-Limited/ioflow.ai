{
  "key": "facebook_graph_api",
  "application": {
    "app_name": "Facebook Graph API",
    "app_type": "api",
    "description": "Comprehensive Facebook Graph API integration for managing pages, posts, insights, and user data. Provides full access to Facebook's social graph including creating/reading/updating/deleting posts, retrieving page analytics, user profile management, and real-time webhook notifications for page activities.",
    "category": "Communication",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://www.facebook.com/v19.0/dialog/oauth",
      "token_url": "https://graph.facebook.com/v19.0/oauth/access_token",
      "scopes": [
        "email",
        "public_profile",
        "pages_show_list",
        "pages_read_engagement",
        "pages_manage_posts",
        "pages_read_user_content",
        "read_insights",
        "business_management"
      ],
      "client_id_param": "client_id",
      "client_secret_param": "client_secret",
      "redirect_uri_param": "redirect_uri",
      "response_type": "code",
      "grant_type": "authorization_code",
      "scope_delimiter": ","
    },
    "version": "1.1.0",
    "base_url": "https://graph.facebook.com/v19.0",
    "icon_url": "https://cdn.cdnlogo.com/logos/f/83/facebook.svg",
    "auth_example": {
      "client_id": "your_client_id",
      "client_secret": "your_client_secret",
      "redirect_uri": "http://localhost:8000/api/v1/oauth/callback"
    },
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "get_user_profile",
      "description": "Get the current user's profile information including name, email, and profile picture",
      "service_type": "api_call",
      "endpoint_template": "/me",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Accept": "application/json"
        },
        "query_params": {
          "fields": "{{fields}}",
          "access_token": "{{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string",
            "description": "Comma-separated list of fields to retrieve"
          }
        },
        "required": []
      },
      "sample_input": {
        "fields": "id,name,email,picture,first_name,last_name"
      },
      "sample_output": {
        "id": "123456789",
        "name": "John Doe",
        "email": "john.doe@example.com",
        "picture": {
          "data": {
            "url": "https://example.com/profile.jpg"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id"
          },
          "name": {
            "type": "string",
            "description": "The name"
          },
          "email": {
            "type": "string",
            "description": "The email"
          },
          "picture": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "The url"
                  }
                },
                "description": "The data"
              }
            },
            "description": "The picture"
          }
        }
      }
    },
