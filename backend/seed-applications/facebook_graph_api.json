    {
      "service_name": "create_page_post",
      "description": "Create a new post on a Facebook Page",
      "service_type": "api_call",
      "endpoint_template": "/{{page_id}}/feed",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body_template": {
          "message": "{{message}}",
          "link": "{{link}}",
          "published": "{{published}}",
          "scheduled_publish_time": "{{scheduled_publish_time}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "The ID of the Facebook Page"
          },
          "message": {
            "type": "string",
            "description": "The text content of the post"
          },
          "link": {
            "type": "string",
            "description": "URL to attach to the post"
          },
          "published": {
            "type": "boolean",
            "description": "Whether to publish immediately or save as draft"
          },
          "scheduled_publish_time": {
            "type": "integer",
            "description": "Unix timestamp for scheduled publishing"
          }
        },
        "required": [
          "page_id",
          "message"
        ]
      },
      "sample_input": {
        "page_id": "123456789",
        "message": "Check out our latest update!",
        "link": "https://example.com/article"
      },
      "sample_output": {
        "id": "123456789_987654321",
        "post_id": "123456789_987654321"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id"
          },
          "post_id": {
            "type": "string",
            "description": "The post_id"
          }
        }
      }
    },
    {
      "service_name": "get_page_posts",
      "description": "Get posts from a Facebook Page feed",
      "service_type": "api_call",
      "endpoint_template": "/{{page_id}}/feed",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Accept": "application/json"
        },
        "query_params": {
          "fields": "{{fields}}",
          "limit": "{{limit}}",
          "since": "{{since}}",
          "until": "{{until}}",
          "access_token": "{{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "The ID of the Facebook Page"
