  "events": [
    {
      "event_name": "page_post_published",
      "description": "Triggered when a new post is published on a Facebook Page",
      "event_type": "webhook",
      "event_configuration": {
        "http_method": "POST",
        "validation": {
          "type": "signature",
          "header": "X-Hub-Signature-256",
          "algorithm": "sha256",
          "secret_param": "webhook_secret"
        },
        "verification": {
          "enabled": true,
          "mode_param": "hub.mode",
          "token_param": "hub.verify_token",
          "challenge_param": "hub.challenge"
        }
      },
      "sample_payload": {
        "entry": [
          {
            "id": "page_id",
            "time": 1628789012345,
            "changes": [
              {
                "field": "feed",
                "value": {
                  "item": "status",
                  "post_id": "123456789_987654321",
                  "verb": "add",
                  "published": 1,
                  "created_time": 1628789012,
                  "message": "New post content"
                }
              }
            ]
          }
        ],
        "object": "page"
      },
      "extraction_configuration": {
        "path_mappings": {
          "event_id": "$.id",
          "event_type": "$.type",
          "data": "$.data"
        }
      }
    },
    {
      "event_name": "page_comment_received",
      "description": "Triggered when a comment is made on a Page post",
      "event_type": "webhook",
      "event_configuration": {
        "http_method": "POST",
        "validation": {
          "type": "signature",
          "header": "X-Hub-Signature-256",
          "algorithm": "sha256",
          "secret_param": "webhook_secret"
        }
      },
      "sample_payload": {
        "entry": [
          {
            "id": "page_id",
            "time": 1628789012345,
            "changes": [
              {
                "field": "feed",
                "value": {
                  "item": "comment",
                  "comment_id": "123456789_987654321",
                  "parent_id": "123456789_111222333",
                  "verb": "add",
                  "created_time": 1628789012,
                  "message": "Great post!",
                  "from": {
                    "id": "user_id",
                    "name": "John Doe"
                  }
                }
              }
            ]
          }
        ],
        "object": "page"
      },
      "extraction_configuration": {
        "path_mappings": {
          "event_id": "$.id",
          "event_type": "$.type",
          "data": "$.data"
        }
      }
    },
