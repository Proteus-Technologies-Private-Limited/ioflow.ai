          "restrictToDomain": {
            "type": "boolean",
            "default": false,
            "description": "Only send responses to users in your domain"
          },
          "startTime": {
            "type": "integer",
            "description": "Start time in epoch milliseconds"
          },
          "endTime": {
            "type": "integer",
            "description": "End time in epoch milliseconds"
          }
        },
        "required": [
          "userId",
          "enableAutoReply"
        ]
