    {
      "service_name": "Watch Mailbox",
      "service_type": "api_call",
      "description": "Set up or update a push notification watch on the given user mailbox",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "topicName": "{{topicName}}",
          "labelIds": "{{labelIds}}",
          "labelFilterAction": "{{labelFilterAction}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me'"
          },
          "topicName": {
            "type": "string",
            "description": "Cloud Pub/Sub topic name"
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of label IDs to watch"
          },
          "labelFilterAction": {
            "type": "string",
            "enum": [
              "include",
              "exclude"
            ],
            "default": "include",
            "description": "Whether to include or exclude the specified labels"
          }
