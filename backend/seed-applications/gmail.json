    {
      "service_name": "Create Label",
      "service_type": "api_call",
      "description": "Creates a new label",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "name": "{{name}}",
          "messageListVisibility": "{{messageListVisibility}}",
          "labelListVisibility": "{{labelListVisibility}}",
          "color": {
            "textColor": "{{textColor}}",
            "backgroundColor": "{{backgroundColor}}"
          }
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me'"
          },
          "name": {
            "type": "string",
            "description": "The display name of the label"
          },
          "messageListVisibility": {
            "type": "string",
            "enum": [
              "show",
              "hide"
            ],
            "default": "show",
            "description": "The visibility of messages with this label in the message list"
          },
          "labelListVisibility": {
            "type": "string",
            "enum": [
              "labelShow",
              "labelShowIfUnread",
              "labelHide"
            ],
            "default": "labelShow",
            "description": "The visibility of the label in the label list"
          },
          "textColor": {
            "type": "string",
            "description": "Text color of the label (hex color code)"
          },
          "backgroundColor": {
            "type": "string",
            "description": "Background color of the label (hex color code)"
          }
        },
        "required": [
          "userId",
          "name"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "/users/{{userId}}/labels"
    },
    {
      "service_name": "Delete Label",
      "service_type": "api_call",
