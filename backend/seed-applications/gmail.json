{
  "key": "gmail",
  "application": {
    "app_name": "Gmail",
    "app_type": "api",
    "description": "Google Gmail API - Access and manage Gmail messages, labels, drafts, and settings",
    "category": "Email",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "redirect_uri": "http://localhost:5173/oauth/callback",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.send",
        "https://www.googleapis.com/auth/gmail.compose",
        "https://www.googleapis.com/auth/gmail.modify",
        "https://www.googleapis.com/auth/gmail.labels",
        "https://www.googleapis.com/auth/gmail.settings.basic",
        "https://www.googleapis.com/auth/gmail.settings.sharing"
      ],
      "grant_type": "authorization_code",
      "authorization_params": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "version": "1.2.0",
    "base_url": "https://gmail.googleapis.com/gmail/v1",
    "icon_url": "https://ssl.gstatic.com/ui/v1/icons/mail/rfr/logo_gmail_lockup_default_1x_r5.png",
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "List Messages",
      "service_type": "api_call",
      "description": "Lists the messages in the user's mailbox",
      "request_config": {
        "parameter_method": "query_params",
        "query_params_template": {
          "q": "{{query}}",
          "labelIds": "{{labelIds}}",
          "maxResults": "{{maxResults}}",
          "pageToken": "{{pageToken}}",
          "includeSpamTrash": "{{includeSpamTrash}}"
        },
        "method": "GET"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me' for authenticated user"
          },
          "query": {
            "type": "string",
            "description": "Query string to filter messages (e.g., 'is:unread', 'from:user@example.com')"
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of label IDs to filter messages"
          },
          "maxResults": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum number of messages to return"
          },
          "pageToken": {
            "type": "string",
            "description": "Page token to retrieve a specific page of results"
          },
          "includeSpamTrash": {
            "type": "boolean",
            "default": false,
            "description": "Include messages from SPAM and TRASH"
          }
        },
        "required": [
          "userId"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "/users/{{userId}}/messages"
    },
    {
      "service_name": "Get Message",
      "service_type": "api_call",
      "description": "Gets the specified message",
      "request_config": {
        "parameter_method": "url_pattern",
        "query_params_template": {
          "format": "{{format}}",
          "metadataHeaders": "{{metadataHeaders}}"
        },
        "method": "GET"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me'"
          },
          "messageId": {
            "type": "string",
            "description": "The ID of the message to retrieve"
          },
          "format": {
            "type": "string",
            "enum": [
              "full",
              "metadata",
              "minimal",
              "raw"
            ],
            "default": "full",
            "description": "The format to return the message in"
          },
          "metadataHeaders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Headers to include when format is metadata"
          }
        },
        "required": [
          "userId",
          "messageId"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "/users/{{userId}}/messages/{{messageId}}"
    },
    {
      "service_name": "Send Message",
      "service_type": "api_call",
      "description": "Sends the specified message",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "raw": "{{raw}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me'"
          },
          "raw": {
            "type": "string",
            "description": "Base64 encoded email message in RFC 2822 format"
          }
        },
        "required": [
          "userId",
          "raw"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "/users/{{userId}}/messages/send"
    },
    {
      "service_name": "Delete Message",
      "service_type": "api_call",
      "description": "Immediately and permanently deletes the specified message",
      "request_config": {
        "parameter_method": "url_pattern",
        "method": "DELETE"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            204
          ]
        },
        "error_extraction": {
          "error_field": "error.message",
          "message_field": "error.message"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "default": "me",
            "description": "The user's email address or 'me'"
          },
          "messageId": {
            "type": "string",
            "description": "The ID of the message to delete"
          }
        },
        "required": [
          "userId",
          "messageId"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "/users/{{userId}}/messages/{{messageId}}"
    },
    {
      "service_name": "Modify Message",
