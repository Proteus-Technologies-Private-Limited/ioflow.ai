{
  "key": "google_calendar",
  "application": {
    "app_name": "Google Calendar",
    "app_type": "api",
    "category": "Productivity",
    "auth_type": "oauth2",
    "description": "Google Calendar integration for managing calendars, events, scheduling, and notifications. Supports creating, reading, updating, and deleting calendar events, managing attendees, and handling event reminders.",
    "base_url": "https://www.googleapis.com/calendar/v3",
    "version": "1.0.13",
    "auth_config": {
      "authorization_url": "https://example.com/oauth/authorize",
      "token_url": "https://example.com/oauth/token",
      "scopes": []
    }
  },
  "services": [
    {
      "service_name": "list_events",
      "description": "List events from a Google Calendar within a specified time range. Returns a list of calendar events with details like summary, start/end times, attendees, and location.",
      "service_type": "api_call",
      "endpoint_template": "/calendars/{{calendar_id}}/events",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Accept": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "query_params_template": {
          "timeMin": "{{time_min}}",
          "timeMax": "{{time_max}}",
          "maxResults": "{{max_results}}",
          "singleEvents": "true",
          "orderBy": "startTime"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "string",
            "description": "Calendar ID (use 'primary' for the main calendar)"
          },
          "time_min": {
            "type": "string",
            "description": "Lower bound (inclusive) for event start time (RFC3339 format)"
          },
          "time_max": {
            "type": "string",
            "description": "Upper bound (exclusive) for event end time (RFC3339 format)"
          },
          "max_results": {
            "type": "integer",
            "description": "Maximum number of events to return (default 250)"
          }
        },
        "required": [
          "calendar_id"
        ],
        "additionalProperties": false
      },
      "sample_output": {
        "kind": "calendar#events",
        "summary": "My Calendar",
        "items": [
          {
            "id": "event123",
            "summary": "Team Meeting",
            "start": {
              "dateTime": "2026-03-17T10:00:00-07:00"
            },
            "end": {
              "dateTime": "2026-03-17T11:00:00-07:00"
            },
            "location": "Conference Room A",
            "attendees": [
              {
                "email": "user@example.com",
                "responseStatus": "accepted"
              }
            ]
          }
        ]
      }
    },
    {
      "service_name": "create_event",
      "description": "Create a new event in a Google Calendar. Supports setting summary, description, start/end times, location, attendees, and reminders.",
      "service_type": "api_call",
      "endpoint_template": "/calendars/{{calendar_id}}/events",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "body_template": {
          "summary": "{{summary}}",
          "description": "{{description}}",
          "location": "{{location}}",
          "start": {
            "dateTime": "{{start_datetime}}",
            "timeZone": "{{timezone}}"
          },
          "end": {
            "dateTime": "{{end_datetime}}",
            "timeZone": "{{timezone}}"
          },
          "attendees": "{{attendees}}",
          "reminders": {
            "useDefault": false,
            "overrides": "{{reminder_overrides}}"
          }
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "string",
            "description": "Calendar ID (use 'primary' for the main calendar)"
          },
          "summary": {
            "type": "string",
            "description": "Title of the event"
          },
          "description": {
            "type": "string",
            "description": "Description or notes for the event"
          },
          "location": {
            "type": "string",
            "description": "Geographic location of the event"
          },
          "start_datetime": {
            "type": "string",
            "description": "Start date-time in RFC3339 format (e.g. 2026-03-17T10:00:00-07:00)"
          },
          "end_datetime": {
            "type": "string",
            "description": "End date-time in RFC3339 format"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. America/Los_Angeles)"
          },
          "attendees": {
            "type": "array",
            "description": "List of attendee objects with email addresses"
          },
          "reminder_overrides": {
            "type": "array",
            "description": "Custom reminder overrides (e.g. [{method: email, minutes: 30}])"
          }
        },
        "required": [
          "calendar_id",
          "summary",
          "start_datetime",
          "end_datetime"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "calendar_id": "primary",
        "summary": "Project Review",
        "description": "Quarterly project review meeting",
        "location": "Meeting Room B",
        "start_datetime": "2026-03-18T14:00:00-07:00",
        "end_datetime": "2026-03-18T15:00:00-07:00",
        "timezone": "America/Los_Angeles",
        "attendees": [
          {
            "email": "colleague@example.com"
          }
        ]
      },
      "sample_output": {
        "kind": "calendar#event",
        "id": "event456",
        "status": "confirmed",
        "summary": "Project Review",
        "start": {
          "dateTime": "2026-03-18T14:00:00-07:00",
          "timeZone": "America/Los_Angeles"
        },
        "end": {
          "dateTime": "2026-03-18T15:00:00-07:00",
          "timeZone": "America/Los_Angeles"
        },
        "htmlLink": "https://www.google.com/calendar/event?eid=event456"
      }
    },
    {
