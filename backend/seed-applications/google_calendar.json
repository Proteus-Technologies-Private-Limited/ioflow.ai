    {
      "service_name": "quick_add_event",
      "description": "Create an event using natural language text (e.g., 'Meeting with John tomorrow at 3pm'). Google Calendar will parse the text to create the event.",
      "service_type": "api_call",
      "endpoint_template": "/calendars/{{calendar_id}}/events/quickAdd",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Authorization": "Bearer {{access_token}}"
        },
        "query_params_template": {
          "text": "{{text}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "string",
            "description": "Calendar ID (use 'primary' for the main calendar)"
          },
          "text": {
            "type": "string",
            "description": "Natural language text describing the event (e.g., 'Lunch with Sarah Friday at noon')"
          }
        },
        "required": [
          "calendar_id",
          "text"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "calendar_id": "primary",
        "text": "Lunch with Sarah Friday at noon at Cafe Bistro"
      },
      "sample_output": {
        "kind": "calendar#event",
        "id": "event789",
        "status": "confirmed",
        "summary": "Lunch with Sarah",
        "start": {
          "dateTime": "2026-03-20T12:00:00-07:00"
        },
        "end": {
          "dateTime": "2026-03-20T13:00:00-07:00"
        }
      }
    },
    {
