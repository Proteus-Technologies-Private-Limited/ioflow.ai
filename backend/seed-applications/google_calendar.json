          },
          "attendees": "{{attendees}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "string",
            "description": "Calendar ID (use 'primary' for the main calendar)"
          },
          "event_id": {
            "type": "string",
            "description": "The unique event identifier"
          },
          "summary": {
            "type": "string",
            "description": "Updated title of the event"
          },
          "description": {
            "type": "string",
            "description": "Updated description"
          },
          "location": {
            "type": "string",
            "description": "Updated location"
          },
          "start_datetime": {
            "type": "string",
            "description": "Updated start date-time in RFC3339 format"
          },
          "end_datetime": {
            "type": "string",
            "description": "Updated end date-time in RFC3339 format"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone"
          },
          "attendees": {
            "type": "array",
            "description": "Updated list of attendees"
          }
        },
        "required": [
          "calendar_id",
          "event_id"
        ],
        "additionalProperties": false
      },
      "sample_output": {
        "kind": "calendar#event",
        "id": "event123",
        "status": "confirmed",
        "summary": "Updated Meeting Title",
        "updated": "2026-03-17T12:00:00.000Z"
      }
    },
    {
      "service_name": "list_calendars",
      "description": "List all calendars available to the authenticated user, including their IDs, names, and access roles.",
      "service_type": "api_call",
      "endpoint_template": "/users/me/calendarList",
