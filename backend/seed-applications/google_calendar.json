          }
        ]
      }
    },
    {
      "service_name": "update_event",
      "description": "Update an existing event in a Google Calendar. Allows modifying summary, description, times, location, attendees, and other event properties.",
      "service_type": "api_call",
      "endpoint_template": "/calendars/{{calendar_id}}/events/{{event_id}}",
      "request_config": {
        "method": "PUT",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
