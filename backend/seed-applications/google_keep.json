{
  "key": "google_keep",
  "application": {
    "app_name": "Google Keep",
    "app_type": "api",
    "category": "Productivity",
    "auth_type": "oauth2",
    "description": "Google Keep integration for creating, reading, updating, and deleting notes, lists, and reminders. Supports labels, colors, pinning, archiving, and collaboration features.",
    "base_url": "https://keep.googleapis.com/v1",
    "version": "1.0.15",
    "auth_config": {
      "authorization_url": "https://example.com/oauth/authorize",
      "token_url": "https://example.com/oauth/token",
      "scopes": []
    }
  },
  "services": [
    {
      "service_name": "create_note",
      "description": "Create a new text note in Google Keep with optional title, labels, color, and pin status",
      "service_type": "api_call",
      "endpoint_template": "/notes",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "body_template": {
          "title": "{{title}}",
          "body": "{{body}}",
          "color": "{{color}}",
          "pinned": "{{pinned}}",
          "labels": "{{labels}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the note"
          },
          "body": {
            "type": "string",
            "description": "Body content of the note"
          },
          "color": {
            "type": "string",
            "description": "Note background color (DEFAULT, RED, ORANGE, YELLOW, GREEN, TEAL, BLUE, CERULEAN, PURPLE, PINK, BROWN, GRAY)"
          },
          "pinned": {
            "type": "boolean",
            "description": "Whether to pin the note"
          },
          "labels": {
            "type": "array",
            "description": "List of label names to apply to the note"
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "title": "Meeting Notes",
        "body": "Discuss Q2 roadmap with the team",
        "color": "BLUE",
        "pinned": true,
        "labels": [
          "Work",
          "Meetings"
        ]
      },
      "sample_output": {
        "id": "note_abc123",
        "title": "Meeting Notes",
        "body": "Discuss Q2 roadmap with the team",
        "color": "BLUE",
        "pinned": true,
        "labels": [
          {
            "name": "Work"
          },
          {
            "name": "Meetings"
          }
        ],
        "created_at": "2026-03-17T10:00:00Z",
        "updated_at": "2026-03-17T10:00:00Z"
      }
    },
    {
      "service_name": "get_note",
      "description": "Retrieve a specific note by its ID from Google Keep",
      "service_type": "api_call",
      "endpoint_template": "/notes/{{note_id}}",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Authorization": "Bearer {{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "description": "The unique identifier of the note to retrieve"
          }
        },
        "required": [
          "note_id"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "note_id": "note_abc123"
      },
      "sample_output": {
        "id": "note_abc123",
        "title": "Meeting Notes",
        "body": "Discuss Q2 roadmap with the team",
        "color": "BLUE",
        "pinned": true,
        "labels": [
          {
            "name": "Work"
          }
        ],
        "created_at": "2026-03-17T10:00:00Z",
        "updated_at": "2026-03-17T10:00:00Z",
        "trashed": false,
        "archived": false
      }
    },
    {
      "service_name": "list_notes",
      "description": "List all notes in Google Keep with optional filtering by label, color, or pin status",
      "service_type": "api_call",
      "endpoint_template": "/notes?label={{label}}&color={{color}}&pinned={{pinned}}&page_size={{page_size}}&page_token={{page_token}}",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Authorization": "Bearer {{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Filter notes by label name"
          },
          "color": {
            "type": "string",
            "description": "Filter notes by color"
          },
          "pinned": {
            "type": "boolean",
            "description": "Filter by pin status"
          },
          "page_size": {
            "type": "integer",
            "description": "Number of notes to return per page"
          },
          "page_token": {
            "type": "string",
            "description": "Token for pagination"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "sample_input": {
        "label": "Work",
        "page_size": 10
      },
      "sample_output": {
        "notes": [
          {
            "id": "note_abc123",
            "title": "Meeting Notes",
            "body": "Discuss Q2 roadmap",
            "color": "BLUE",
            "pinned": true
          }
        ],
        "next_page_token": "token_xyz",
        "total_count": 25
      }
    },
    {
      "service_name": "update_note",
      "description": "Update an existing note's title, body, color, pin status, or labels in Google Keep",
      "service_type": "api_call",
      "endpoint_template": "/notes/{{note_id}}",
      "request_config": {
        "method": "PATCH",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "body_template": {
          "title": "{{title}}",
          "body": "{{body}}",
          "color": "{{color}}",
          "pinned": "{{pinned}}",
          "labels": "{{labels}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "description": "The unique identifier of the note to update"
          },
          "title": {
            "type": "string",
            "description": "Updated title"
          },
          "body": {
            "type": "string",
            "description": "Updated body content"
          },
          "color": {
            "type": "string",
            "description": "Updated background color"
          },
          "pinned": {
            "type": "boolean",
            "description": "Updated pin status"
          },
          "labels": {
            "type": "array",
            "description": "Updated list of label names"
          }
        },
        "required": [
          "note_id"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "note_id": "note_abc123",
        "title": "Updated Meeting Notes",
        "color": "GREEN"
      },
      "sample_output": {
        "id": "note_abc123",
        "title": "Updated Meeting Notes",
        "body": "Discuss Q2 roadmap with the team",
        "color": "GREEN",
        "pinned": true,
        "updated_at": "2026-03-17T11:00:00Z"
      }
    },
    {
      "service_name": "delete_note",
