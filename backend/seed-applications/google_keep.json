    {
      "service_name": "search_notes",
      "description": "Search for notes in Google Keep by keyword, label, color, or other criteria",
      "service_type": "api_call",
      "endpoint_template": "/notes/search?query={{query}}&label={{label}}&color={{color}}&type={{type}}&archived={{archived}}&page_size={{page_size}}",
