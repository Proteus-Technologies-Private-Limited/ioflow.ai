    {
      "service_name": "create_list",
      "description": "Create a new checklist (list note) in Google Keep with items that can be checked off",
      "service_type": "api_call",
      "endpoint_template": "/notes",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "body_template": {
          "title": "{{title}}",
          "type": "LIST",
          "list_items": "{{list_items}}",
          "color": "{{color}}",
          "pinned": "{{pinned}}",
          "labels": "{{labels}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the list"
          },
          "list_items": {
            "type": "array",
            "description": "Array of list items, each with 'text' and optional 'checked' boolean"
          },
          "color": {
            "type": "string",
            "description": "List background color"
          },
          "pinned": {
            "type": "boolean",
            "description": "Whether to pin the list"
          },
          "labels": {
            "type": "array",
            "description": "List of label names to apply"
          }
        },
        "required": [
          "list_items"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "title": "Grocery List",
        "list_items": [
          {
            "text": "Milk",
            "checked": false
          },
          {
            "text": "Eggs",
            "checked": false
          },
          {
            "text": "Bread",
            "checked": true
          }
        ],
        "color": "YELLOW"
      },
      "sample_output": {
        "id": "note_list456",
        "title": "Grocery List",
        "type": "LIST",
        "list_items": [
          {
            "id": "item_1",
            "text": "Milk",
            "checked": false
          },
          {
            "id": "item_2",
            "text": "Eggs",
            "checked": false
          },
          {
            "id": "item_3",
            "text": "Bread",
            "checked": true
          }
        ],
        "color": "YELLOW",
        "created_at": "2026-03-17T10:00:00Z"
      }
    },
    {
      "service_name": "create_reminder",
      "description": "Set a time-based or location-based reminder on a Google Keep note",
      "service_type": "api_call",
      "endpoint_template": "/notes/{{note_id}}/reminders",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{access_token}}"
        },
        "body_template": {
          "reminder_type": "{{reminder_type}}",
          "reminder_time": "{{reminder_time}}",
          "recurrence": "{{recurrence}}",
          "location": "{{location}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "description": "The note ID to attach the reminder to"
          },
          "reminder_type": {
            "type": "string",
            "description": "Type of reminder: TIME or LOCATION"
          },
          "reminder_time": {
            "type": "string",
            "description": "ISO 8601 datetime for time-based reminders"
          },
          "recurrence": {
            "type": "string",
            "description": "Recurrence pattern (DAILY, WEEKLY, MONTHLY, YEARLY, or NONE)"
          },
          "location": {
            "type": "object",
            "description": "Location object with latitude, longitude, and address for location-based reminders"
          }
        },
        "required": [
          "note_id",
          "reminder_type"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "note_id": "note_abc123",
        "reminder_type": "TIME",
        "reminder_time": "2026-03-18T09:00:00Z",
        "recurrence": "WEEKLY"
      },
      "sample_output": {
        "id": "reminder_789",
        "note_id": "note_abc123",
        "reminder_type": "TIME",
        "reminder_time": "2026-03-18T09:00:00Z",
        "recurrence": "WEEKLY",
        "status": "ACTIVE"
      }
    },
