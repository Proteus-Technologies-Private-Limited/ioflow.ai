        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword to match against note title and body"
          },
          "label": {
            "type": "string",
            "description": "Filter by label name"
          },
          "color": {
            "type": "string",
            "description": "Filter by note color"
          },
          "type": {
            "type": "string",
            "description": "Filter by note type: NOTE or LIST"
          },
          "archived": {
            "type": "boolean",
            "description": "Include archived notes"
          },
          "page_size": {
            "type": "integer",
            "description": "Number of results per page"
          }
        },
        "required": [],
