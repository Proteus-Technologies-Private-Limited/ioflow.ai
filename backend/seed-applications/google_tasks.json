{
  "key": "google_tasks",
  "application": {
    "app_name": "Google Tasks",
    "app_type": "api",
    "description": "Google Tasks API - Create, manage, and organize tasks and task lists",
    "category": "Productivity",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/tasks",
        "https://www.googleapis.com/auth/tasks.readonly"
      ],
      "grant_type": "authorization_code",
      "authorization_params": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "version": "2.1.0",
    "base_url": "https://tasks.googleapis.com/tasks/v1",
    "icon_url": "https://ssl.gstatic.com/tasks/logo_tasks_color_2x_web_64dp.png",
    "auth_example": {
      "client_id": "your_client_id",
      "client_secret": "your_client_secret",
      "redirect_uri": "http://localhost:8000/api/v1/oauth/callback"
    },
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "list_task_lists",
      "description": "Lists all the authenticated user's task lists",
      "service_type": "api_call",
      "request_config": {
        "parameter_method": "query_params",
        "query_params_template": {
          "maxResults": "{{maxResults}}",
          "pageToken": "{{pageToken}}"
        },
        "method": "GET"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of task lists to return"
          },
          "pageToken": {
            "type": "string",
            "description": "Page token to retrieve a specific page of results"
          }
        },
        "required": []
      },
      "sample_input": {
        "maxResults": 10
      },
      "sample_output": {
        "kind": "tasks#taskLists",
        "items": [
          {
            "kind": "tasks#taskList",
            "id": "MTAwMTQ3MDI4NTg4NjU0MzY0ODQ6MDow",
            "title": "My Tasks",
            "updated": "2025-07-27T10:30:00.000Z"
          }
        ]
      },
      "endpoint_template": "/users/@me/lists",
      "output_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "The kind"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "The kind"
                },
                "id": {
                  "type": "string",
                  "description": "The id"
                },
                "title": {
                  "type": "string",
                  "description": "The title"
                },
                "updated": {
                  "type": "string",
                  "description": "The updated"
                }
              }
            },
            "description": "The items"
          }
        }
      }
    },
