    {
      "service_name": "list_tasks",
      "description": "Returns all tasks in the specified task list",
      "service_type": "api_call",
      "request_config": {
        "parameter_method": "query_params",
        "query_params_template": {
          "maxResults": "{{maxResults}}",
          "pageToken": "{{pageToken}}",
          "showCompleted": "{{showCompleted}}",
          "showHidden": "{{showHidden}}",
          "showDeleted": "{{showDeleted}}",
          "updatedMin": "{{updatedMin}}",
          "completedMax": "{{completedMax}}",
          "completedMin": "{{completedMin}}",
          "dueMax": "{{dueMax}}",
          "dueMin": "{{dueMin}}"
        },
        "method": "GET"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "tasklist": {
            "type": "string",
            "description": "Task list identifier",
            "parameterLookup": {
              "type": "api_call",
              "service": "list_task_lists",
              "parameters": {},
              "extractPath": "items",
              "valueField": "id",
              "displayField": "title",
              "description": "Select from available task lists"
            }
          },
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of tasks to return"
          },
          "showCompleted": {
            "type": "boolean",
            "description": "Show completed tasks"
          }
        },
        "required": [
          "tasklist"
        ]
      },
      "sample_input": {
        "tasklist": "MTAwMTQ3MDI4NTg4NjU0MzY0ODQ6MDow",
        "maxResults": 10,
        "showCompleted": true
      },
      "sample_output": {
        "kind": "tasks#tasks",
        "items": [
          {
            "kind": "tasks#task",
            "id": "MDQ4NjE3MzA2MDc5OTgxNjUzOTQ6MDow",
            "title": "Buy groceries",
            "updated": "2025-07-27T10:30:00.000Z",
            "status": "needsAction"
          }
        ]
      },
      "endpoint_template": "/lists/{{tasklist}}/tasks",
      "output_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "The kind"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "The kind"
                },
                "id": {
                  "type": "string",
                  "description": "The id"
                },
                "title": {
                  "type": "string",
                  "description": "The title"
