    {
      "service_name": "create_task",
      "description": "Creates a new task in the specified task list",
      "service_type": "api_call",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "title": "{{title}}",
          "notes": "{{notes}}",
          "due": "{{due}}",
          "status": "{{status}}",
          "parent": "{{parent}}",
          "previous": "{{previous}}"
        },
        "method": "POST"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "tasklist": {
            "type": "string",
            "description": "Task list identifier",
            "parameterLookup": {
              "type": "api_call",
              "service": "list_task_lists",
              "parameters": {},
              "extractPath": "items",
              "valueField": "id",
              "displayField": "title",
              "description": "Select from available task lists"
            }
          },
          "title": {
            "type": "string",
            "description": "Task title"
          },
          "notes": {
            "type": "string",
            "description": "Task notes or description"
          },
          "due": {
            "type": "string",
            "description": "Due date in RFC 3339 format"
          }
        },
        "required": [
          "tasklist",
          "title"
        ]
      },
      "sample_input": {
        "tasklist": "MTAwMTQ3MDI4NTg4NjU0MzY0ODQ6MDow",
        "title": "Call dentist",
        "notes": "Schedule annual checkup",
        "due": "2025-08-01T00:00:00.000Z"
