    {
      "service_name": "add_watermark",
      "display_name": "Add Text Watermark",
      "service_type": "file_operation",
      "description": "Add a text watermark to an image",
      "parameter_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "default": "watermark",
            "enum": ["watermark"],
            "ui_control": "hidden"
          },
          "image": {
            "type": "string",
            "description": "Image to watermark",
            "format": "base64",
            "ui_control": "file",
            "accept": "image/*"
          },
          "text": {
            "type": "string",
            "default": "WATERMARK",
            "description": "Watermark text"
          },
          "position": {
            "type": "string",
            "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"],
            "default": "bottom-right",
            "description": "Watermark position"
          },
          "opacity": {
            "type": "number",
            "default": 0.5,
            "minimum": 0,
            "maximum": 1,
            "description": "Watermark opacity"
          },
          "font_size": {
            "type": "integer",
            "default": 30,
            "minimum": 10,
            "maximum": 200,
            "description": "Font size in pixels"
          },
          "color": {
            "type": "string",
            "default": "white",
            "enum": ["white", "black"],
            "description": "Watermark color"
          },
          "output_format": {
            "type": "string",
            "enum": ["PNG", "JPEG", "WEBP"],
            "default": "PNG"
          }
        },
        "required": ["image"]
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 30
    }
  ]
}