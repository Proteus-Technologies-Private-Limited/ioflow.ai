{
  "key": "imap_email",
  "application": {
    "app_name": "IMAP Email",
    "app_type": "email",
    "description": "Send and receive emails using IMAP protocol with folder support. Supports Gmail, Outlook, and other IMAP servers.",
    "category": "Communication",
    "auth_type": "basic",
    "auth_config": {
      "username_field": "username",
      "password_field": "password",
      "description": "Enter your email credentials (usually your email address and password/app password)"
    },
    "version": "1.1.0",
    "base_url": "",
    "icon_url": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v8/icons/mail-dot-ru.svg",
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "Send Email",
      "display_name": "Send Email via IMAP",
      "service_type": "smtp_send",
      "description": "Send emails via IMAP server (uses SMTP protocol internally)",
      "endpoint_template": "/imap/send",
      "request_config": {
        "method": "POST",
        "parameter_method": "json_payload"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address (comma-separated for multiple)",
            "format": "email"
          },
          "cc": {
            "type": "string",
            "description": "CC recipients (comma-separated)"
          },
          "bcc": {
            "type": "string",
            "description": "BCC recipients (comma-separated)"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line"
          },
          "body": {
            "type": "string",
            "description": "Email body content"
          },
          "body_type": {
            "type": "string",
            "enum": [
              "plain",
              "html"
            ],
            "default": "plain",
            "description": "Email body format"
          },
          "attachments": {
            "type": "array",
            "description": "Email attachments",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Attachment filename"
                },
                "content": {
                  "type": "string",
                  "description": "Base64 encoded file content"
                },
                "content_type": {
                  "type": "string",
                  "description": "MIME content type"
                }
              },
              "required": [
                "filename",
                "content"
              ]
            }
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the email was sent successfully"
          },
          "message": {
            "type": "string",
            "description": "Status message"
          },
          "message_id": {
            "type": "string",
            "description": "Generated message ID"
          }
        }
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 60
    },
    {
      "service_name": "Receive Emails",
      "display_name": "Receive Emails via IMAP",
      "service_type": "imap_receive",
      "description": "Retrieve emails from IMAP server with advanced search and folder support",
      "endpoint_template": "/imap/receive",
      "request_config": {
        "method": "GET",
        "parameter_method": "query_params"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "default": "INBOX",
            "description": "Email folder to read from (e.g., INBOX, Sent, Drafts)"
          },
          "search_query": {
            "type": "string",
            "default": "UNSEEN",
            "description": "IMAP search criteria (e.g., UNSEEN, FROM sender@example.com, SUBJECT 'important')"
          },
          "message_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Maximum number of messages to retrieve"
          },
          "include_body": {
            "type": "boolean",
            "default": true,
            "description": "Include message body in response"
          },
          "include_attachments": {
            "type": "boolean",
            "default": false,
            "description": "Include attachments in response"
          },
          "mark_as_read": {
            "type": "boolean",
            "default": true,
            "description": "Mark messages as read after retrieving"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the operation was successful"
          },
          "folder": {
            "type": "string",
            "description": "Folder that was accessed"
          },
          "messages": {
            "type": "array",
            "description": "Retrieved email messages",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "uid": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "cc": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "body_text": {
                  "type": "string"
                },
                "body_html": {
                  "type": "string"
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "filename": {
                        "type": "string"
                      },
                      "content_type": {
                        "type": "string"
                      },
                      "size": {
                        "type": "integer"
                      },
                      "content": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 60
    }
  ],
  "events": [
    {
      "event_name": "new_email_received",
      "display_name": "New Email Received",
      "event_type": "polling",
      "description": "Triggered when a new email is received via IMAP polling",
      "event_configuration": {
        "interval_seconds": 300,
        "polling_service": "Receive Emails",
        "polling_parameters": {
          "folder": "INBOX",
          "search_query": "UNSEEN",
          "message_count": 10,
          "mark_as_read": false
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "description": "Unique message identifier"
          },
          "uid": {
            "type": "string",
            "description": "IMAP UID"
          },
          "from": {
            "type": "string",
            "description": "Sender email address"
          },
          "to": {
            "type": "string",
            "description": "Recipient email address"
          },
          "cc": {
            "type": "string",
            "description": "CC recipients"
          },
          "subject": {
            "type": "string",
            "description": "Email subject"
          },
          "body_text": {
            "type": "string",
            "description": "Plain text email body"
          },
          "body_html": {
            "type": "string",
            "description": "HTML email body"
          },
          "date": {
            "type": "string",
            "description": "Email date/time"
          },
          "attachments": {
            "type": "array",
            "description": "Email attachments",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                },
                "content": {
                  "type": "string",
                  "description": "Base64 encoded content"
                }
              }
            }
          }
        },
        "required": [
          "message_id",
          "from",
          "to",
          "subject",
          "date"
        ]
      },
      "sample_payload": {
        "message_id": "msg_12345",
        "uid": "123",
        "from": "sender@example.com",
        "to": "recipient@example.com",
        "subject": "Test Email Subject",
        "body_text": "This is the plain text body of the email.",
        "date": "Mon, 20 Jan 2025 10:30:00 +0000"
      }
    }
  ],
  "metadata": {
    "author": "IOFlow Team",
    "created_at": "2025-01-20",
    "tags": [
      "email",
      "imap",
      "communication"
    ],
    "notes": "IMAP email client with send and receive capabilities. Configure base_url as imap://host:port or imaps://host:port (e.g., imap://imap.gmail.com:143 or imaps://imap.gmail.com:993)",
    "services_count": 2,
    "events_count": 1
  }
}