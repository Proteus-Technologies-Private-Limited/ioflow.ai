{
  "key": "instagram_graph_api",
  "application": {
    "app_name": "Instagram Graph API",
    "app_type": "api",
    "app_scope": "global",
    "description": "Comprehensive Instagram Graph API integration for managing Instagram Business and Creator accounts. Provides access to user profiles, media management, insights, comments, hashtag discovery, and messaging. Supports OAuth 2.0 authentication and real-time webhook notifications for Instagram activities.",
    "category": "Communication",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://www.facebook.com/v19.0/dialog/oauth",
      "token_url": "https://graph.facebook.com/v19.0/oauth/access_token",
      "exchange_token_url": "https://graph.instagram.com/access_token",
      "refresh_token_url": "https://graph.instagram.com/refresh_access_token",
      "scopes": [
        "instagram_basic",
        "instagram_manage_messages",
        "instagram_manage_comments",
        "instagram_content_publish",
        "pages_show_list",
        "pages_read_engagement",
        "business_management",
        "instagram_manage_insights"
      ],
      "client_id_param": "client_id",
      "client_secret_param": "client_secret",
      "redirect_uri_param": "redirect_uri",
      "response_type": "code",
      "grant_type": "authorization_code",
      "scope_delimiter": ",",
      "token_exchange_required": true,
      "token_exchange_grant_type": "ig_exchange_token"
    },
    "version": "1.1.0",
    "base_url": "https://graph.instagram.com",
    "icon_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/a5/Instagram_icon.png/600px-Instagram_icon.png",
    "auth_example": {
      "client_id": "your_client_id",
      "client_secret": "your_client_secret",
      "redirect_uri": "http://localhost:8000/api/v1/oauth/callback"
    }
  },
  "services": [
    {
      "service_name": "get_user_profile",
      "description": "Get the Instagram Business or Creator account profile information",
      "service_type": "api_call",
      "endpoint_template": "/me",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Accept": "application/json"
        },
        "query_params": {
          "fields": "{{fields}}",
          "access_token": "{{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string",
            "description": "Comma-separated list of fields to retrieve"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "sample_input": {
        "fields": "id,username,followers_count,media_count"
      },
      "sample_output": {
        "id": "17841400000000000",
        "username": "mybusiness",
        "followers_count": 5000,
        "media_count": 150
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id"
          },
          "username": {
            "type": "string",
            "description": "The username"
          },
          "followers_count": {
            "type": "integer",
            "description": "Number of followers_s"
          },
          "media_count": {
            "type": "integer",
            "description": "Number of media_s"
          }
        }
      }
    },
    {
      "service_name": "get_user_media",
      "description": "Get a list of media objects (posts, reels, stories) from an Instagram Business or Creator account",
      "service_type": "api_call",
      "endpoint_template": "/{{ig_user_id}}/media",
      "request_config": {
        "method": "GET",
        "headers_template": {
          "Accept": "application/json"
        },
        "query_params": {
          "fields": "{{fields}}",
          "limit": "{{limit}}",
          "since": "{{since}}",
          "until": "{{until}}",
          "access_token": "{{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "ig_user_id": {
            "type": "string",
            "description": "Instagram User ID"
          },
          "fields": {
            "type": "string",
            "description": "Fields to retrieve for each media"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of media to return"
          },
          "since": {
            "type": "string",
            "description": "Unix timestamp or date for media after this time"
          },
          "until": {
            "type": "string",
            "description": "Unix timestamp or date for media before this time"
          }
        },
        "required": [
          "ig_user_id"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "ig_user_id": "17841400000000000",
        "fields": "id,caption,media_type,media_url,timestamp",
        "limit": 10
      },
      "sample_output": {
        "data": [
          {
            "id": "17895695668004550",
            "caption": "Welcome to our Instagram!",
            "media_type": "IMAGE",
            "media_url": "https://example.com/image.jpg",
            "timestamp": "2025-08-13T10:00:00+0000"
          }
        ],
        "paging": {
          "cursors": {
            "before": "xxx",
            "after": "yyy"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id"
                },
                "caption": {
                  "type": "string",
                  "description": "The caption"
                },
                "media_type": {
                  "type": "string",
                  "description": "The media_type"
                },
                "media_url": {
                  "type": "string",
                  "description": "The media_url"
                },
                "timestamp": {
                  "type": "string",
                  "description": "The timestamp"
                }
              }
            },
            "description": "The data"
          },
          "paging": {
            "type": "object",
            "properties": {
              "cursors": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "description": "The before"
                  },
                  "after": {
                    "type": "string",
                    "description": "The after"
                  }
                },
                "description": "The cursors"
              }
            },
            "description": "The paging"
          }
        }
      }
    },
    {
      "service_name": "create_media_container",
      "description": "Create a media container for publishing a single image, video, or carousel to Instagram",
      "service_type": "api_call",
      "endpoint_template": "/{{ig_user_id}}/media",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body_template": {
          "image_url": "{{image_url}}",
          "video_url": "{{video_url}}",
          "caption": "{{caption}}",
          "location_id": "{{location_id}}",
          "user_tags": "{{user_tags}}",
          "access_token": "{{access_token}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "ig_user_id": {
            "type": "string",
            "description": "Instagram User ID"
          },
          "image_url": {
            "type": "string",
            "description": "URL of the image to publish (for IMAGE posts)"
          },
          "video_url": {
            "type": "string",
            "description": "URL of the video to publish (for VIDEO posts)"
          },
          "caption": {
            "type": "string",
            "description": "Caption for the media, including hashtags and mentions"
          },
          "location_id": {
            "type": "string",
            "description": "Facebook Page location ID"
          },
          "user_tags": {
            "type": "array",
            "description": "Array of user tags"
          }
        },
        "required": [
          "ig_user_id"
        ],
        "additionalProperties": false
      },
      "sample_input": {
        "ig_user_id": "17841400000000000",
        "image_url": "https://example.com/image.jpg",
        "caption": "Check out our new product! #newproduct #instagram"
      },
      "sample_output": {
        "id": "17889455560051444"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id"
          }
        }
      }
    },
