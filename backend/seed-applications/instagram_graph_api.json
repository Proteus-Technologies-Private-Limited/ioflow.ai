  "events": [
    {
      "event_name": "comment_received",
      "description": "Triggered when a new comment is posted on your Instagram media",
      "event_type": "webhook",
      "event_configuration": {
        "http_method": "POST",
        "validation": {
          "type": "signature",
          "header": "X-Hub-Signature-256",
          "algorithm": "sha256",
          "secret_param": "webhook_secret"
        },
        "verification": {
          "enabled": true,
          "mode_param": "hub.mode",
          "token_param": "hub.verify_token",
          "challenge_param": "hub.challenge"
        }
      },
      "sample_payload": {
        "entry": [
          {
            "id": "instagram_business_account_id",
            "time": 1628789012345,
            "changes": [
              {
                "field": "comments",
                "value": {
                  "id": "comment_id",
                  "media": {
                    "id": "media_id",
                    "media_product_type": "FEED"
                  },
                  "text": "Great post!",
                  "from": {
                    "id": "user_id",
                    "username": "user123"
                  }
                }
              }
            ]
          }
        ],
        "object": "instagram"
      },
      "extraction_configuration": {
        "path_mappings": {
          "event_id": "$.id",
          "event_type": "$.type",
          "data": "$.data"
        }
      }
    },
    {
      "event_name": "message_received",
      "description": "Triggered when you receive a new message on Instagram",
      "event_type": "webhook",
      "event_configuration": {
        "http_method": "POST",
