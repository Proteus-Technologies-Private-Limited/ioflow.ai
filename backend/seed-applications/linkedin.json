  "events": [
    {
      "event_name": "organization_social_actions",
      "description": "Webhook notifications for social actions (likes, comments, shares) on organization posts. Requires LinkedIn Partner Program access.",
      "event_type": "webhook",
      "event_configuration": {
        "webhook_url": "{{webhook_url}}",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "validation": {
          "type": "challenge_response",
          "challenge_param": "challengeCode",
          "response_field": "challengeResponse",
          "signature_header": "X-LI-Signature",
          "signature_method": "HMACSHA256",
          "secret": "{{client_secret}}"
        },
        "retry_policy": {
          "max_retries": 3,
          "retry_on": [
            500,
            502,
            503,
            504
          ],
          "backoff_multiplier": 2
        }
      },
      "sample_payload": "{\"notificationId\": \"urn:li:notification:123456\", \"eventType\": \"ORGANIZATION_SOCIAL_ACTION_NOTIFICATIONS\", \"organizationUrn\": \"urn:li:organization:12345\", \"actorUrn\": \"urn:li:person:67890\", \"objectUrn\": \"urn:li:share:123456\", \"verb\": \"LIKED\", \"eventTime\": 1627488000000}",
      "output_schema": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "description": "Parameter extracted from $.id",
            "mapping": "$.id"
          },
          "event_type": {
            "type": "string",
            "description": "Parameter extracted from $.type",
            "mapping": "$.type"
          },
          "data": {
            "type": "string",
            "description": "Parameter extracted from $.data",
            "mapping": "$.data"
          }
        },
        "required": [],
        "parameter_extraction": {
          "method": "json_path",
          "mappings": {
            "event_id": "$.id",
            "event_type": "$.type",
            "data": "$.data"
          }
        }
      }
    },
    {
      "event_name": "new_connections",
      "description": "Poll for new connections added to the user's network",
      "event_type": "polling",
      "event_configuration": {
        "service_name": "get_connections",
        "interval_seconds": 3600,
        "comparison_field": "to",
        "comparison_type": "new_items",
        "store_state": true,
        "initial_poll_limit": 50
      },
      "sample_payload": "{\"to\": \"urn:li:person:ABC123\", \"to~\": {\"id\": \"ABC123\", \"firstName\": {\"localized\": {\"en_US\": \"Jane\"}}, \"lastName\": {\"localized\": {\"en_US\": \"Smith\"}}, \"headline\": {\"localized\": {\"en_US\": \"Software Engineer at TechCorp\"}}}}",
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "event_name": "new_posts",
      "description": "Poll for new posts from a specific author (person or organization)",
      "event_type": "polling",
      "event_configuration": {
        "service_name": "get_posts",
        "interval_seconds": 1800,
        "comparison_field": "id",
        "comparison_type": "new_items",
        "store_state": true,
        "initial_poll_limit": 10,
        "service_params": {
          "author_urn": "{{monitored_author_urn}}"
