    {
      "service_name": "get_profile",
      "description": "Get authenticated user's LinkedIn profile information including name, headline, location, and profile picture",
      "service_type": "api_call",
      "request_config": {
        "headers_template": {
          "X-Restli-Protocol-Version": "2.0.0"
        },
        "query_params": {
          "projection": "(id,firstName,lastName,profilePicture(displayImage~:playableStreams))"
        },
        "method": "GET"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "projection": {
            "type": "string",
            "description": "Fields to retrieve from profile"
          }
        },
        "required": []
      },
      "sample_output": {
        "id": "dXJuOmxpOnBlcnNvbjoxMjM0NTY",
        "firstName": {
          "localized": {
            "en_US": "John"
          },
          "preferredLocale": {
            "country": "US",
            "language": "en"
          }
        },
        "lastName": {
          "localized": {
            "en_US": "Doe"
