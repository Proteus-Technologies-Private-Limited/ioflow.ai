    {
      "service_name": "create_post",
      "description": "Create a new post on LinkedIn profile or company page. Supports text, images, videos, and articles.",
      "service_type": "api_call",
      "request_config": {
        "headers_template": {
          "X-Restli-Protocol-Version": "2.0.0",
          "LinkedIn-Version": "202506",
          "Content-Type": "application/json"
        },
        "method": "POST"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "description": "URN of the author (person or organization)"
          },
          "commentary": {
            "type": "string",
            "description": "Text content of the post"
          },
          "visibility": {
            "type": "string",
            "description": "Post visibility (PUBLIC, CONNECTIONS)"
          },
          "media": {
            "type": "object",
            "description": "Media content (image, video, article)"
          }
        },
        "required": [
          "author",
          "commentary"
        ]
      },
      "sample_input": {
        "author": "urn:li:person:123456",
        "commentary": "Check out this amazing update!",
        "visibility": "PUBLIC"
      },
      "sample_output": {
        "id": "urn:li:share:6844785523593134080",
        "author": "urn:li:person:123456",
        "lifecycleState": "PUBLISHED",
        "visibility": "PUBLIC"
      },
      "endpoint_template": "/rest/posts",
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id"
          },
          "author": {
            "type": "string",
            "description": "The author"
          },
          "lifecycleState": {
            "type": "string",
            "description": "The lifecycleState"
          },
          "visibility": {
            "type": "string",
            "description": "The visibility"
          }
        }
      }
    },
