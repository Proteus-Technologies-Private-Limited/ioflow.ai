{
  "key": "linkedin",
  "application": {
    "app_name": "LinkedIn",
    "app_type": "api",
    "description": "LinkedIn API integration for professional networking, content sharing, and business development. Supports OAuth 2.0 authentication, profile management, posts creation, and organization management.",
    "category": "Communication",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://www.linkedin.com/oauth/v2/authorization",
      "token_url": "https://www.linkedin.com/oauth/v2/accessToken",
      "scopes": [
        "r_liteprofile",
        "r_emailaddress",
        "w_member_social",
        "r_organization",
        "w_organization_social",
        "r_basicprofile",
        "r_1st_connections"
      ],
      "client_id_param": "client_id",
      "client_secret_param": "client_secret",
      "grant_type": "authorization_code",
      "redirect_uri_required": true,
      "pkce_required": false,
      "state_required": true,
      "response_type": "code",
      "token_expiry": 5184000,
      "refresh_token_supported": false,
      "header_prefix": "Bearer",
      "additional_params": {
        "scope_delimiter": " "
      }
    },
    "version": "1.1.0",
    "base_url": "https://api.linkedin.com",
    "icon_url": "https://upload.wikimedia.org/wikipedia/commons/c/ca/LinkedIn_logo_initials.png",
    "auth_example": {
      "client_id": "your_client_id",
      "client_secret": "your_client_secret",
      "redirect_uri": "http://localhost:8000/api/v1/oauth/callback"
    },
    "app_scope": "global"
  },
