{
  "key": "openai",
  "application": {
    "app_name": "OpenAI",
    "app_type": "api",
    "description": "OpenAI API - Access GPT models, DALL-E, Whisper, and other AI capabilities",
    "category": "AI/ML",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "Authorization",
      "header_prefix": "Bearer",
      "description": "OpenAI API Key"
    },
    "version": "1.5.0",
    "base_url": "https://api.openai.com/v1",
    "icon_url": "/static/app_icons/openai.png",
    "configuration_schema": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API Key",
          "description": "Your OpenAI API key",
          "encrypted": true,
          "required": true
        },
        "organization_id": {
          "type": "string",
          "title": "Organization ID",
          "description": "Optional OpenAI organization ID",
          "required": false
        }
      }
    }
  },
  "services": [
    {
      "service_name": "cancel_batch",
      "display_name": "Cancel Batch",
      "service_type": "api_call",
      "description": "Cancels an in-progress batch",
      "endpoint_template": "/batches/{{batch_id}}/cancel",
      "request_config": {
        "parameter_method": "url_pattern",
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string",
            "description": "The ID of the batch to cancel"
          }
        },
        "required": [
          "batch_id"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "cancel_fine_tuning_job",
      "display_name": "Cancel Fine Tuning Job",
      "service_type": "api_call",
      "description": "Immediately cancel a fine-tuning job",
      "endpoint_template": "/fine_tuning/jobs/{{fine_tuning_job_id}}/cancel",
      "request_config": {
        "parameter_method": "url_pattern",
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "fine_tuning_job_id": {
            "type": "string",
            "description": "The ID of the fine-tuning job to cancel"
          }
        },
        "required": [
          "fine_tuning_job_id"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_batch",
      "display_name": "Create Batch",
      "service_type": "api_call",
      "description": "Creates and executes a batch from an uploaded file of requests",
      "endpoint_template": "/batches",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "input_file_id": "{{input_file_id}}",
          "endpoint": "{{endpoint}}",
          "completion_window": "{{completion_window}}",
          "metadata": "{{metadata}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "input_file_id": {
            "type": "string",
            "description": "The ID of the uploaded batch input file"
          },
          "endpoint": {
            "type": "string",
            "description": "The endpoint to be used for all requests",
            "enum": [
              "/v1/chat/completions",
              "/v1/embeddings",
              "/v1/completions"
            ]
          },
          "completion_window": {
            "type": "string",
            "description": "The time frame within which requests should be processed",
            "enum": [
              "24h"
            ]
          },
          "metadata": {
            "type": "object",
            "description": "Optional custom metadata"
          }
        },
        "required": [
          "input_file_id",
          "endpoint",
          "completion_window"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_chat_completion",
      "display_name": "Create Chat Completion",
      "service_type": "api_call",
      "description": "Creates a chat completion using GPT models including GPT-4o and GPT-3.5-turbo",
      "endpoint_template": "/chat/completions",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "audio": "{{audio}}",
          "frequency_penalty": "{{frequency_penalty}}",
          "logit_bias": "{{logit_bias}}",
          "logprobs": "{{logprobs}}",
          "max_completion_tokens": "{{max_completion_tokens}}",
          "max_tokens": "{{max_tokens}}",
          "metadata": "{{metadata}}",
          "modalities": "{{modalities}}",
          "n": "{{n}}",
          "parallel_tool_calls": "{{parallel_tool_calls}}",
          "prediction": "{{prediction}}",
          "presence_penalty": "{{presence_penalty}}",
          "prompt_cache_key": "{{prompt_cache_key}}",
          "reasoning_effort": "{{reasoning_effort}}",
          "response_format": "{{response_format}}",
          "safety_identifier": "{{safety_identifier}}",
          "seed": "{{seed}}",
          "service_tier": "{{service_tier}}",
          "stop": "{{stop}}",
          "store": "{{store}}",
          "stream": "{{stream}}",
          "stream_options": "{{stream_options}}",
          "temperature": "{{temperature}}",
          "tool_choice": "{{tool_choice}}",
          "tools": "{{tools}}",
          "top_logprobs": "{{top_logprobs}}",
          "top_p": "{{top_p}}",
          "web_search_options": "{{web_search_options}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Model ID used to generate the response, like gpt-4o or o3",
            "enum": [
              "gpt-5-mini",
              "gpt-4o",
              "gpt-4o-mini",
              "gpt-4-turbo",
              "gpt-4",
              "gpt-3.5-turbo",
              "o3",
              "o4-mini"
            ],
            "default": "gpt-4o-mini"
          },
          "messages": {
            "type": "array",
            "description": "A list of messages comprising the conversation so far. Supports text, images, and audio depending on model",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "function",
                    "developer"
                  ],
                  "description": "The role of the message author"
                },
                "content": {
                  "type": "string",
                  "description": "The contents of the message"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the author (for function messages)"
                }
              },
              "required": [
                "role",
                "content"
              ]
            }
          },
          "frequency_penalty": {
            "type": "number",
            "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency",
            "default": 0,
            "minimum": -2,
            "maximum": 2
          },
          "logit_bias": {
            "type": "object",
            "description": "Modify the likelihood of specified tokens appearing in the completion"
          },
          "logprobs": {
            "type": "boolean",
            "description": "Whether to return log probabilities of the output tokens",
            "default": false
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "An upper bound for the number of tokens that can be generated, including reasoning tokens"
          },
          "metadata": {
            "type": "object",
            "description": "Set of 16 key-value pairs for storing additional information"
          },
          "n": {
            "type": "integer",
            "description": "How many chat completion choices to generate for each input message",
            "default": 1
          },
          "parallel_tool_calls": {
            "type": "boolean",
            "description": "Whether to enable parallel function calling during tool use",
            "default": true
          },
          "presence_penalty": {
            "type": "number",
            "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far",
            "default": 0,
            "minimum": -2,
            "maximum": 2
          },
          "response_format": {
            "type": "object",
            "description": "An object specifying the format that the model must output",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "Response format type"
              },
              "json_schema": {
                "type": "object",
                "description": "JSON schema for structured outputs (when type is json_schema)"
              }
            }
          },
          "seed": {
            "type": "integer",
            "description": "For deterministic sampling (Beta feature)"
          },
          "service_tier": {
            "type": "string",
            "description": "Specifies the processing type used for serving the request",
            "enum": [
              "auto",
              "default",
              "flex",
              "priority"
            ],
            "default": "auto"
          },
          "stop": {
            "description": "Up to 4 sequences where the API will stop generating. Not supported with o3 and o4-mini",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              }
            ]
          },
          "store": {
            "type": "boolean",
            "description": "Whether to store the output for use in model distillation or evals",
            "default": false
          },
          "stream": {
            "type": "boolean",
            "description": "If true, partial message deltas will be sent using server-sent events",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "description": "Options for streaming response. Only set when stream: true",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Include usage information in the stream"
              }
            }
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature between 0 and 2. Higher values make output more random",
            "default": 1,
            "minimum": 0,
            "maximum": 2
          },
          "tool_choice": {
            "description": "Controls which (if any) tool is called by the model",
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "auto",
                  "required"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "function": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          },
          "tools": {
            "type": "array",
            "description": "A list of tools the model may call. Max 128 functions supported",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "parameters": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "top_logprobs": {
            "type": "integer",
            "description": "Number of most likely tokens to return at each position (0-20). Requires logprobs: true",
            "minimum": 0,
            "maximum": 20
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus sampling: only tokens with top_p probability mass are considered",
            "default": 1,
            "minimum": 0,
            "maximum": 1
          },
          "max_tokens": {
            "type": "integer",
            "description": "Maximum number of tokens to generate",
            "minimum": 1
          },
          "modalities": {
            "type": "array",
            "description": "Output types for the model (available for GPT-4o and newer)",
            "items": {
              "type": "string",
              "enum": [
                "text",
                "audio"
              ]
            },
            "default": [
              "text"
            ]
          },
          "audio": {
            "type": "object",
            "description": "Audio output parameters (requires modalities: ['audio'])",
            "properties": {
              "voice": {
                "type": "string",
                "enum": [
                  "alloy",
                  "echo",
                  "fable",
                  "onyx",
                  "nova",
                  "shimmer"
                ],
                "description": "Voice for audio output"
              },
              "format": {
                "type": "string",
                "enum": [
                  "wav",
                  "mp3",
                  "flac",
                  "opus",
                  "pcm16"
                ],
                "description": "Audio output format"
              }
            }
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Reasoning effort level (o3 and o4-mini models only)",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "prompt_cache_key": {
            "type": "string",
            "description": "Cache key for response caching"
          },
          "safety_identifier": {
            "type": "string",
            "description": "Identifier for usage policy tracking"
          },
          "web_search_options": {
            "type": "object",
            "description": "Web search configuration (model-dependent)",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable web search"
              }
            }
          },
          "prediction": {
            "type": "object",
            "description": "Predicted output configuration for faster responses",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "content"
                ],
                "description": "Prediction type"
              },
              "content": {
                "type": "string",
                "description": "Predicted content"
              }
            }
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_embeddings",
      "display_name": "Create Embeddings",
      "service_type": "api_call",
      "description": "Creates an embedding vector representing the input text",
      "endpoint_template": "/embeddings",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "input": "{{input}}",
          "model": "{{model}}",
          "encoding_format": "{{encoding_format}}",
          "dimensions": "{{dimensions}}",
          "user": "{{user}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "input": {
            "description": "Input text to embed",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "model": {
            "type": "string",
            "description": "ID of the model to use",
            "enum": [
              "text-embedding-3-small",
              "text-embedding-3-large",
              "text-embedding-ada-002"
            ],
            "default": "text-embedding-3-small"
          },
          "encoding_format": {
            "type": "string",
            "description": "The format to return embeddings in",
            "enum": [
              "float",
              "base64"
            ],
            "default": "float"
          },
          "dimensions": {
            "type": "integer",
            "description": "Number of dimensions for the output embeddings",
            "minimum": 1
          },
          "user": {
            "type": "string",
            "description": "Unique identifier representing end-user"
          }
        },
        "required": [
          "input",
          "model"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_fine_tuning_job",
      "display_name": "Create Fine Tuning Job",
      "service_type": "api_call",
      "description": "Creates a fine-tuning job",
      "endpoint_template": "/fine_tuning/jobs",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "training_file": "{{training_file}}",
          "validation_file": "{{validation_file}}",
          "model": "{{model}}",
          "hyperparameters": "{{hyperparameters}}",
          "suffix": "{{suffix}}",
          "seed": "{{seed}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "training_file": {
            "type": "string",
            "description": "The ID of the uploaded training file"
          },
          "validation_file": {
            "type": "string",
            "description": "The ID of the uploaded validation file"
          },
          "model": {
            "type": "string",
            "description": "The name of the model to fine-tune",
            "enum": [
              "gpt-3.5-turbo",
              "babbage-002",
              "davinci-002"
            ]
          },
          "hyperparameters": {
            "type": "object",
            "properties": {
              "batch_size": {
                "type": "integer",
                "description": "Batch size to use for training"
              },
              "learning_rate_multiplier": {
                "type": "number",
                "description": "Scaling factor for learning rate"
              },
              "n_epochs": {
                "type": "integer",
                "description": "Number of epochs to train for"
              }
            }
          },
          "suffix": {
            "type": "string",
            "description": "String to add to fine-tuned model name",
            "maxLength": 18
          },
          "seed": {
            "type": "integer",
            "description": "Random seed"
          }
        },
        "required": [
          "training_file",
          "model"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_image",
      "display_name": "Create Image",
      "service_type": "api_call",
      "description": "Creates an image given a prompt",
      "endpoint_template": "/images/generations",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "prompt": "{{prompt}}",
          "model": "{{model}}",
          "n": "{{n}}",
          "quality": "{{quality}}",
          "response_format": "{{response_format}}",
          "size": "{{size}}",
          "style": "{{style}}",
          "user": "{{user}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text description of the desired image(s)",
            "maxLength": 4000
          },
          "model": {
            "type": "string",
            "description": "The model to use for image generation",
            "enum": [
              "dall-e-3",
              "dall-e-2"
            ],
            "default": "dall-e-3"
          },
          "n": {
            "type": "integer",
            "description": "Number of images to generate",
            "default": 1,
            "minimum": 1,
            "maximum": 10
          },
          "quality": {
            "type": "string",
            "description": "Quality of the image",
            "enum": [
              "standard",
              "hd"
            ],
            "default": "standard"
          },
          "response_format": {
            "type": "string",
            "description": "Format in which images are returned",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          },
          "size": {
            "type": "string",
            "description": "Size of the generated images",
            "enum": [
              "256x256",
              "512x512",
              "1024x1024",
              "1792x1024",
              "1024x1792"
            ],
            "default": "1024x1024"
          },
          "style": {
            "type": "string",
            "description": "Style of the generated images",
            "enum": [
              "vivid",
              "natural"
            ],
            "default": "vivid"
          },
          "user": {
            "type": "string",
            "description": "Unique identifier representing end-user"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_image_variation",
      "display_name": "Create Image Variation",
      "service_type": "api_call",
      "description": "Creates a variation of a given image",
      "endpoint_template": "/images/variations",
      "request_config": {
        "parameter_method": "form_data",
        "form_data_template": {
          "image": "{{image}}",
          "model": "{{model}}",
          "n": "{{n}}",
          "response_format": "{{response_format}}",
          "size": "{{size}}",
          "user": "{{user}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
        },
        "data_path": "data",
        "error_path": "error.message"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "description": "The image to use as basis (PNG, max 4MB)"
          },
          "model": {
            "type": "string",
            "description": "The model to use",
            "default": "dall-e-2"
          },
          "n": {
            "type": "integer",
            "description": "Number of images to generate",
            "default": 1,
            "minimum": 1,
            "maximum": 10
          },
          "response_format": {
            "type": "string",
            "description": "Format in which images are returned",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          },
          "size": {
            "type": "string",
            "description": "Size of the generated images",
            "enum": [
              "256x256",
              "512x512",
              "1024x1024"
            ],
            "default": "1024x1024"
          },
          "user": {
            "type": "string",
            "description": "Unique identifier representing end-user"
          }
        },
        "required": [
          "image"
        ]
      },
      "output_schema": {},
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
    {
      "service_name": "create_moderation",
      "display_name": "Create Moderation",
      "service_type": "api_call",
      "description": "Classifies if text violates OpenAI's Content Policy",
      "endpoint_template": "/moderations",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "input": "{{input}}",
          "model": "{{model}}"
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": 200
