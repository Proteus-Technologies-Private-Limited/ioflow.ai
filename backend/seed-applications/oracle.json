          },
          "message": {
            "type": "string",
            "description": "Result message"
          }
        }
      },
      "timeout_seconds": 30,
      "is_active": true
    },
    {
      "service_name": "rollback_transaction",
      "description": "Roll back the flow-scoped Oracle Database transaction. Use with an explicit step when the application is configured with autocommit=false.",
      "service_type": "database_query",
      "service_config": {
        "operation_type": "rollback",
        "timeout_seconds": 30,
        "transaction_mode": "manual"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the rollback step ran"
          },
          "rolled_back": {
            "type": "boolean",
            "description": "True if an open transaction was rolled back"
          },
          "message": {
            "type": "string",
            "description": "Result message"
          }
        }
      },
      "timeout_seconds": 30,
      "is_active": true
    }
  ],
