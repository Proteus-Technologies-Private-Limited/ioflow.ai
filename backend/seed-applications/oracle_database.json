          "sql": {
            "type": "string",
            "description": "SQL query that returns a single row",
            "example": "SELECT id, name, email, status FROM users WHERE id = :user_id"
          }
        },
        "required": [
          "sql"
        ],
        "additionalProperties": true
      },
      "sample_input": {
        "sql": "SELECT id, name, email, status FROM users WHERE id = :user_id",
        "user_id": 123
      },
      "sample_output": {
        "success": true,
        "data": {
          "id": 123,
          "name": "John Doe",
          "email": "john@example.com",
          "status": "active"
        },
        "row_count": 1
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "integer",
            "description": "The success"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The id"
              },
              "name": {
                "type": "string",
