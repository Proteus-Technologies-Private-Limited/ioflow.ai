                "page": {"type": "integer", "minimum": 1},
                "text": {"type": "string"},
                "x": {"type": "number"},
                "y": {"type": "number"}
              },
              "required": ["page", "text"]
            }
          }
        },
        "required": ["pdf", "annotations"]
