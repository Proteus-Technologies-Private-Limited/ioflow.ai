          "size": {"type": "integer"}
        }
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 30
    },
    {
      "service_name": "add_pdf_annotations",
      "display_name": "Add PDF Annotations",
      "service_type": "file_operation",
      "description": "Add annotations and comments to a PDF document",
      "parameter_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "default": "add_annotations",
            "enum": ["add_annotations"],
            "ui_control": "hidden"
          },
          "pdf": {
            "type": "string",
            "description": "PDF file to annotate",
            "format": "base64",
            "ui_control": "file",
            "accept": "application/pdf"
          },
          "annotations": {
            "type": "array",
            "description": "Annotations to add",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["text", "highlight", "note"],
                  "default": "text"
