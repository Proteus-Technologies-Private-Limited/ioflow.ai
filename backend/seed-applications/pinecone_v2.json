            "type": "integer",
            "description": "Number of replicas (optional)"
          },
          "pods": {
            "type": "integer",
            "description": "Number of pods (optional)"
          },
          "metadata_config": {
            "type": "object",
            "description": "Optional metadata configuration"
          }
        },
        "required": [
          "name",
          "dimension"
        ]
      }
    }
