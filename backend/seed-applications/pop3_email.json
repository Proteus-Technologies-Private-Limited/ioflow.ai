{
  "key": "pop3_email",
  "application": {
    "app_name": "POP3 Email",
    "app_type": "email",
    "description": "Receive emails using POP3 protocol. Supports Gmail, Outlook, and other POP3 servers.",
    "category": "Communication",
    "auth_type": "basic",
    "auth_config": {
      "username_field": "username",
      "password_field": "password",
      "description": "Enter your email credentials (usually your email address and password/app password)"
    },
    "version": "1.1.0",
    "base_url": "",
    "icon_url": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v8/icons/mail-dot-ru.svg",
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "Receive Emails",
      "display_name": "Receive Emails",
      "service_type": "pop3_receive",
      "description": "Retrieve emails from POP3 server with support for message parsing and attachments",
      "endpoint_template": "/pop3/receive",
      "request_config": {
        "method": "GET",
        "parameter_method": "query_params"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "message_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Number of messages to retrieve"
          },
          "include_body": {
            "type": "boolean",
            "default": true,
            "description": "Include message body in response"
          },
          "include_attachments": {
            "type": "boolean",
            "default": false,
            "description": "Include attachments in response"
          },
          "delete_after_read": {
            "type": "boolean",
            "default": false,
            "description": "Delete messages from server after reading"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the operation was successful"
          },
          "messages": {
            "type": "array",
            "description": "Retrieved email messages",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "cc": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "body_text": {
                  "type": "string"
                },
                "body_html": {
                  "type": "string"
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "filename": {
                        "type": "string"
                      },
                      "content_type": {
                        "type": "string"
                      },
                      "size": {
                        "type": "integer"
                      },
                      "content": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 60
    }
  ],
  "events": [],
  "metadata": {
    "author": "IOFlow Team",
    "created_at": "2025-01-20",
    "tags": [
      "email",
      "pop3",
      "communication"
    ],
    "notes": "POP3 email receiver. Configure base_url as pop3://host:port or pop3s://host:port (e.g., pop3://pop.gmail.com:110 or pop3s://pop.gmail.com:995)",
    "services_count": 1,
    "events_count": 0
  }
}