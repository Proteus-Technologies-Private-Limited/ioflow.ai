{
  "key": "sendgrid",
  "application": {
    "app_name": "SendGrid",
    "app_type": "api",
    "description": "Email delivery and management service",
    "category": "Communication",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "Authorization",
      "header_prefix": "Bearer",
      "api_key_field": "sendgrid_api_key"
    },
    "version": "1.1.0",
    "base_url": "https://api.sendgrid.com/v3",
    "icon_url": "https://sendgrid.com/wp-content/themes/sgdotcom/pages/resource/brand/2016/SendGrid-Logomark.png",
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "Send Email",
      "service_type": "api_call",
      "description": "Send an email through SendGrid",
      "request_config": {
        "parameter_method": "json_payload",
        "body_template": {
          "personalizations": [
            {
              "to": [
                {
                  "email": "{{to_email}}",
                  "name": "{{to_name}}"
                }
              ],
              "subject": "{{subject}}"
            }
          ],
          "from": {
            "email": "{{from_email}}",
            "name": "{{from_name}}"
          },
          "content": [
            {
              "type": "text/html",
              "value": "{{html_content}}"
            }
          ]
        },
        "method": "POST"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": [
            202
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "to_email": {
            "type": "string",
            "format": "email",
            "description": "Recipient email address"
          },
          "to_name": {
            "type": "string",
            "description": "Recipient name"
          },
          "from_email": {
            "type": "string",
            "format": "email",
            "description": "Sender email address"
          },
          "from_name": {
            "type": "string",
            "description": "Sender name"
          },
          "subject": {
            "type": "string",
            "description": "Email subject"
          },
          "html_content": {
            "type": "string",
            "description": "HTML content of the email"
          }
        },
        "required": [
          "to_email",
          "from_email",
          "subject",
          "html_content"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "{{base_url}}/mail/send"
    },
    {
      "service_name": "Get Email Stats",
      "service_type": "api_call",
      "description": "Get email statistics",
      "request_config": {
        "parameter_method": "query_params",
        "query_template": {
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}",
          "aggregated_by": "{{aggregated_by}}"
        },
        "method": "GET"
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "value": [
            200
          ]
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Start date (YYYY-MM-DD)"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "End date (YYYY-MM-DD)"
          },
          "aggregated_by": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month"
            ],
            "default": "day",
            "description": "How to aggregate stats"
          }
        },
        "required": [
          "start_date"
        ]
      },
      "sync_mode": "synchronous",
      "endpoint_template": "{{base_url}}/stats"
    }
  ],
  "events": [
    {
      "event_name": "Email Event",
      "event_type": "webhook",
      "description": "Webhook for email events (delivered, opened, clicked, etc.)",
      "event_configuration": {
        "webhook_url": "/webhooks/sendgrid/email-events",
        "verification_type": "none"
      },
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  ],
  "metadata": {
    "author": "IOFlow Team",
    "created_at": "2024-01-01",
    "tags": [
      "email",
      "communication",
      "api-key"
    ],
    "last_modified": "2025-08-23T12:53:14.109960",
    "modified_by": "claude-code",
    "events_count": 1
  }
}