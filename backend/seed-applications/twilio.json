      "event_configuration": {
        "webhook_url": "/webhooks/twilio/sms-status",
        "verification_type": "signature",
        "signature_header": "X-Twilio-Signature"
      },
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "event_name": "Incoming WhatsApp Message",
      "event_type": "webhook",
      "description": "Webhook triggered when a WhatsApp message is received",
      "event_configuration": {
        "webhook_url": "/webhooks/twilio/whatsapp",
        "verification_type": "signature",
        "signature_header": "X-Twilio-Signature"
      },
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "event_name": "Voice Call Status",
      "event_type": "webhook",
      "description": "Webhook for voice call status updates",
      "event_configuration": {
        "webhook_url": "/webhooks/twilio/call-status",
        "verification_type": "signature",
        "signature_header": "X-Twilio-Signature"
      },
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "event_name": "Incoming Voice Call",
      "event_type": "webhook",
      "description": "Webhook triggered when a call is received",
      "event_configuration": {
        "webhook_url": "/webhooks/twilio/voice",
        "verification_type": "signature",
        "signature_header": "X-Twilio-Signature"
      },
      "output_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  ],
  "metadata": {
    "author": "IOFlow Team",
    "created_at": "2025-01-03",
    "tags": [
      "sms",
