    {
      "service_name": "download_page_files",
      "display_name": "Download Page Files",
      "service_type": "file_operation",
      "description": "Download files linked from a webpage (e.g. monthly portfolio disclosures). Links are matched on their URL path or query value, narrowed by url_contains, and files a previous run took are left out via skip_urls. Set render_js for pages whose links are drawn by JavaScript, include_content=false to list links only.",
      "parameter_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "default": "download_files",
            "enum": [
              "download_files"
            ],
            "ui_control": "hidden"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL of the webpage"
          },
          "file_extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".doc",
              ".docx",
              ".xls",
              ".xlsx",
              ".zip"
            ],
            "description": "File extensions to download"
          },
          "max_files": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum files to download (up to 200)"
          },
          "url_contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keep only links whose URL or link text contains one of these (case-insensitive), e.g. [\"2026\", \"flexi\"]"
          },
          "skip_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File URLs already processed by an earlier run; they are not downloaded again"
          },
          "render_js": {
            "type": "boolean",
            "default": false,
            "description": "Render the page in a headless browser first (links added by JavaScript)"
          },
          "wait_selector": {
            "type": "string",
            "description": "With render_js: CSS selector to wait for before reading links"
          },
          "include_content": {
            "type": "boolean",
            "default": true,
            "description": "false = return the matching links only, without downloading"
          }
        },
        "required": [
          "url"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "files_found": {
            "type": "integer"
          },
          "files_downloaded": {
            "type": "integer"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "extension": {
                  "type": "string"
                },
                "content": {
                  "type": "string",
                  "format": "base64"
                },
                "size": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "sync_mode": "synchronous",
      "timeout_seconds": 120
    },
