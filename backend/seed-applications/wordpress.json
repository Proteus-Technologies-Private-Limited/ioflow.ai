{
  "key": "wordpress",
  "application": {
    "app_name": "WordPress",
    "app_type": "api",
    "app_scope": "tenant",
    "description": "WordPress CMS integration with comprehensive REST API support. Manage posts, pages, users, comments, media, categories, and custom post types. Supports both WordPress.com and self-hosted WordPress installations with webhook capabilities.",
    "category": "Integration",
    "auth_type": "basic",
    "auth_config": {
      "username_field": "username",
      "password_field": "app_password",
      "base64_encode": true,
      "header_name": "Authorization",
      "header_prefix": "Basic",
      "description": "Use WordPress username and Application Password. Application Passwords can be created in WordPress under Users > Profile > Application Passwords",
      "test_endpoint": "/users/me",
      "required_permissions": [
        "read",
        "write"
      ]
    },
    "version": "1.1.0",
    "base_url": "https://{domain}/wp-json/wp/v2",
    "icon_url": "https://s.w.org/style/images/about/WordPress-logotype-standard.png"
  },
  "services": [
    {
      "service_name": "get_posts",
      "description": "Retrieve posts from WordPress with optional filters",
      "service_type": "api_call",
      "endpoint_template": "/posts",
      "request_config": {
        "method": "GET",
        "parameter_method": "query",
        "headers_template": {
          "Content-Type": "application/json"
        },
        "query_template": {
          "per_page": "{{per_page}}",
          "page": "{{page}}",
          "search": "{{search}}",
          "status": "{{status}}",
          "categories": "{{categories}}",
          "tags": "{{tags}}",
          "orderby": "{{orderby}}",
          "order": "{{order}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "integer",
            "description": "Number of posts per page (max 100)",
            "default": 10
          },
          "page": {
            "type": "integer",
            "description": "Page number",
            "default": 1
          },
          "search": {
            "type": "string",
            "description": "Search term for posts"
          },
          "status": {
            "type": "string",
            "description": "Post status (publish, draft, private, etc.)",
            "default": "publish"
          },
          "categories": {
            "type": "string",
            "description": "Category IDs (comma-separated)"
          },
          "tags": {
            "type": "string",
            "description": "Tag IDs (comma-separated)"
          },
          "orderby": {
            "type": "string",
            "description": "Order posts by (date, title, id, etc.)",
            "default": "date"
          },
          "order": {
            "type": "string",
            "description": "Order direction (asc or desc)",
            "default": "desc"
          }
        }
      },
      "sample_input": {
        "per_page": 10,
        "page": 1,
        "status": "publish",
        "orderby": "date",
        "order": "desc"
      },
      "sample_output": {
        "posts": [
          {
            "id": 123,
            "date": "2025-08-23T10:00:00",
            "title": {
              "rendered": "Sample Post Title"
            },
            "content": {
              "rendered": "<p>Post content here...</p>"
            },
            "excerpt": {
              "rendered": "<p>Post excerpt...</p>"
            },
            "status": "publish",
            "link": "https://example.com/sample-post/",
            "categories": [
              1,
              2
            ],
            "tags": [
              5,
              8
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "The id"
                },
                "date": {
                  "type": "string",
                  "description": "The date"
                },
                "title": {
                  "type": "object",
                  "properties": {
                    "rendered": {
                      "type": "string",
                      "description": "The rendered"
                    }
                  },
                  "description": "The title"
                },
                "content": {
                  "type": "object",
                  "properties": {
                    "rendered": {
                      "type": "string",
                      "description": "The rendered"
                    }
                  },
                  "description": "The content"
                },
                "excerpt": {
                  "type": "object",
                  "properties": {
                    "rendered": {
                      "type": "string",
                      "description": "The rendered"
                    }
                  },
                  "description": "The excerpt"
                },
                "status": {
                  "type": "string",
                  "description": "The status"
                },
                "link": {
                  "type": "string",
                  "description": "The link"
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "The categories"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "The tags"
                }
              }
            },
            "description": "The posts"
          }
        }
      }
    },
    {
      "service_name": "create_post",
      "description": "Create a new WordPress post",
      "service_type": "api_call",
      "endpoint_template": "/posts",
      "request_config": {
        "method": "POST",
        "parameter_method": "body",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Basic {{auth.credentials}}"
        },
        "body_template": {
          "title": "{{title}}",
          "content": "{{content}}",
          "excerpt": "{{excerpt}}",
          "status": "{{status}}",
          "categories": "{{categories}}",
          "tags": "{{tags}}",
          "featured_media": "{{featured_media}}",
          "meta": "{{meta}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post content (HTML allowed)"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "status": {
            "type": "string",
            "description": "Post status (publish, draft, private, pending)",
            "default": "draft"
          },
          "categories": {
            "type": "array",
            "description": "Array of category IDs",
            "items": {
              "type": "integer"
            }
          },
          "tags": {
            "type": "array",
            "description": "Array of tag IDs",
            "items": {
              "type": "integer"
            }
          },
          "featured_media": {
            "type": "integer",
            "description": "Featured image ID"
          },
          "meta": {
            "type": "object",
            "description": "Post meta fields"
          }
        },
        "required": [
          "title",
          "content"
        ]
      },
      "sample_input": {
        "title": "New Blog Post",
        "content": "<p>This is the content of my new blog post.</p>",
        "excerpt": "A brief summary of the post",
        "status": "publish",
        "categories": [
          1,
          3
        ],
        "tags": [
          5,
          7
        ]
      },
      "sample_output": {
        "id": 456,
        "date": "2025-08-23T11:30:00",
        "title": {
          "rendered": "New Blog Post"
        },
        "content": {
          "rendered": "<p>This is the content of my new blog post.</p>"
        },
        "status": "publish",
        "link": "https://example.com/new-blog-post/"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id"
          },
          "date": {
            "type": "string",
            "description": "The date"
          },
          "title": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The title"
          },
          "content": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The content"
          },
          "status": {
            "type": "string",
            "description": "The status"
          },
          "link": {
            "type": "string",
            "description": "The link"
          }
        }
      }
    },
    {
      "service_name": "update_post",
      "description": "Update an existing WordPress post",
      "service_type": "api_call",
      "endpoint_template": "/posts/{{post_id}}",
      "request_config": {
        "method": "PUT",
        "parameter_method": "body",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Basic {{auth.credentials}}"
        },
        "body_template": {
          "title": "{{title}}",
          "content": "{{content}}",
          "excerpt": "{{excerpt}}",
          "status": "{{status}}",
          "categories": "{{categories}}",
          "tags": "{{tags}}",
          "featured_media": "{{featured_media}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "integer",
            "description": "ID of the post to update"
          },
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post content"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "status": {
            "type": "string",
            "description": "Post status"
          },
          "categories": {
            "type": "array",
            "description": "Category IDs",
            "items": {
              "type": "integer"
            }
          },
          "tags": {
            "type": "array",
            "description": "Tag IDs",
            "items": {
              "type": "integer"
            }
          },
          "featured_media": {
            "type": "integer",
            "description": "Featured image ID"
          }
        },
        "required": [
          "post_id"
        ]
      },
      "sample_input": {
        "post_id": 456,
        "title": "Updated Blog Post Title",
        "content": "<p>Updated content goes here.</p>",
        "status": "publish"
      },
      "sample_output": {
        "id": 456,
        "title": {
          "rendered": "Updated Blog Post Title"
        },
        "content": {
          "rendered": "<p>Updated content goes here.</p>"
        },
        "status": "publish",
        "modified": "2025-08-23T12:00:00"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id"
          },
          "title": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The title"
          },
          "content": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The content"
          },
          "status": {
            "type": "string",
            "description": "The status"
          },
          "modified": {
            "type": "string",
            "description": "The modified"
          }
        }
      }
    },
    {
      "service_name": "delete_post",
      "description": "Delete a WordPress post",
      "service_type": "api_call",
      "endpoint_template": "/posts/{{post_id}}",
      "request_config": {
        "method": "DELETE",
        "parameter_method": "query",
        "headers_template": {
          "Authorization": "Basic {{auth.credentials}}"
        },
        "query_template": {
          "force": "{{force}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "integer",
            "description": "ID of the post to delete"
          },
          "force": {
            "type": "boolean",
            "description": "Whether to bypass trash and force deletion",
            "default": false
          }
        },
        "required": [
          "post_id"
        ]
      },
      "sample_input": {
        "post_id": 456,
        "force": false
      },
      "sample_output": {
        "deleted": true,
        "previous": {
          "id": 456,
          "title": {
            "rendered": "Deleted Post Title"
          },
          "status": "trash"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "integer",
            "description": "The deleted"
          },
          "previous": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The id"
              },
              "title": {
                "type": "object",
                "properties": {
                  "rendered": {
                    "type": "string",
                    "description": "The rendered"
                  }
                },
                "description": "The title"
              },
              "status": {
                "type": "string",
                "description": "The status"
              }
            },
            "description": "The previous"
          }
        }
      }
    },
    {
      "service_name": "create_page",
      "description": "Create a new WordPress page",
      "service_type": "api_call",
      "endpoint_template": "/pages",
      "request_config": {
        "method": "POST",
        "parameter_method": "body",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Basic {{auth.credentials}}"
        },
        "body_template": {
          "title": "{{title}}",
          "content": "{{content}}",
          "excerpt": "{{excerpt}}",
          "status": "{{status}}",
          "parent": "{{parent}}",
          "menu_order": "{{menu_order}}",
          "featured_media": "{{featured_media}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Page title"
          },
          "content": {
            "type": "string",
            "description": "Page content (HTML allowed)"
          },
          "excerpt": {
            "type": "string",
            "description": "Page excerpt"
          },
          "status": {
            "type": "string",
            "description": "Page status (publish, draft, private)",
            "default": "draft"
          },
          "parent": {
            "type": "integer",
            "description": "Parent page ID"
          },
          "menu_order": {
            "type": "integer",
            "description": "Order of page in menu"
          },
          "featured_media": {
            "type": "integer",
            "description": "Featured image ID"
          }
        },
        "required": [
          "title",
