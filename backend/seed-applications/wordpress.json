        "properties": {
          "id": {
            "type": "integer",
            "description": "The id"
          },
          "title": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The title"
          },
          "content": {
            "type": "object",
            "properties": {
              "rendered": {
                "type": "string",
                "description": "The rendered"
              }
            },
            "description": "The content"
          },
          "status": {
            "type": "string",
            "description": "The status"
          },
          "link": {
            "type": "string",
            "description": "The link"
          }
        }
      }
    },
    {
      "service_name": "create_user",
      "description": "Create a new WordPress user",
      "service_type": "api_call",
      "endpoint_template": "/users",
      "request_config": {
        "method": "POST",
        "parameter_method": "body",
        "headers_template": {
          "Content-Type": "application/json",
          "Authorization": "Basic {{auth.credentials}}"
        },
        "body_template": {
          "username": "{{username}}",
          "email": "{{email}}",
          "password": "{{password}}",
          "name": "{{name}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "roles": "{{roles}}",
          "description": "{{description}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Login name for the user"
          },
          "email": {
            "type": "string",
            "description": "Email address for the user"
          },
          "password": {
            "type": "string",
            "description": "Password for the user"
          },
          "name": {
            "type": "string",
            "description": "Display name for the user"
          },
          "first_name": {
            "type": "string",
            "description": "First name for the user"
          },
          "last_name": {
            "type": "string",
            "description": "Last name for the user"
          },
          "roles": {
            "type": "array",
            "description": "Roles assigned to the user",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "description": "Description of the user"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "sample_input": {
        "username": "johndoe",
        "email": "john@example.com",
        "password": "SecurePassword123!",
        "first_name": "John",
        "last_name": "Doe",
        "roles": [
          "subscriber"
        ]
      },
      "sample_output": {
        "id": 234,
        "username": "johndoe",
        "name": "John Doe",
        "email": "john@example.com",
        "roles": [
          "subscriber"
        ],
        "link": "https://example.com/author/johndoe/"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The id"
          },
          "username": {
            "type": "string",
            "description": "The username"
          },
          "name": {
            "type": "string",
            "description": "The name"
          },
          "email": {
            "type": "string",
            "description": "The email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The roles"
          },
          "link": {
            "type": "string",
            "description": "The link"
          }
        }
      }
    },
    {
