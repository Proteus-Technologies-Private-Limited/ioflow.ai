{
  "key": "x_twitter",
  "application": {
    "app_name": "X (Twitter)",
    "app_type": "api",
    "description": "X (formerly Twitter) API v2 integration for social media management, tweet posting, user interactions, and real-time streaming. Supports OAuth 2.0 with PKCE for user context operations.",
    "category": "Communication",
    "auth_type": "oauth2",
    "auth_config": {
      "authorization_url": "https://twitter.com/i/oauth2/authorize",
      "token_url": "https://api.twitter.com/2/oauth2/token",
      "revoke_url": "https://api.twitter.com/2/oauth2/revoke",
      "scopes": [
        "tweet.read",
        "tweet.write",
        "tweet.moderate.write",
        "users.read",
        "follows.read",
        "follows.write",
        "offline.access",
        "space.read",
        "mute.read",
        "mute.write",
        "like.read",
        "like.write",
        "list.read",
        "list.write",
        "block.read",
        "block.write",
        "bookmark.read",
        "bookmark.write",
        "dm.read",
        "dm.write"
      ],
      "client_id_param": "client_id",
      "client_secret_param": "client_secret",
      "grant_type": "authorization_code",
      "redirect_uri_required": true,
      "pkce_required": true,
      "state_required": true,
      "response_type": "code",
      "token_expiry": 7200,
      "refresh_token_supported": true,
      "header_prefix": "Bearer",
      "code_challenge_method": "S256",
      "additional_params": {
        "scope_delimiter": " ",
        "include_granted_scopes": true
      }
    },
    "version": "2.4.0",
    "base_url": "https://api.twitter.com",
    "icon_url": "https://abs.twimg.com/responsive-web/client-web/icon-ios.77d25eba.png",
    "auth_example": {
      "client_id": "your_client_id",
      "client_secret": "your_client_secret",
      "redirect_uri": "http://localhost:8000/api/v1/oauth/callback"
    },
    "app_scope": "global"
  },
  "services": [
    {
      "service_name": "create_tweet",
      "description": "Create a new tweet with text content",
      "service_type": "api_call",
      "endpoint_template": "/2/tweets",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "Content-Type": "application/json"
        },
        "body_template": {
          "text": "{{text}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text content of the tweet (max 280 characters)"
          }
        },
        "required": [
          "text"
        ]
      },
      "sample_input": {
        "text": "Hello X API v2! This is my first tweet from IOFlow 🚀"
      },
      "sample_output": {
        "data": {
          "id": "1445880548472328192",
          "text": "Hello X API v2! This is my first tweet from IOFlow 🚀"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The id"
              },
              "text": {
                "type": "string",
                "description": "The text"
              }
            },
            "description": "The data"
          }
        }
      }
    },
    {
      "service_name": "delete_tweet",
      "description": "Delete a tweet by its ID",
      "service_type": "api_call",
      "endpoint_template": "/2/tweets/{{tweet_id}}",
      "request_config": {
        "method": "DELETE"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "tweet_id": {
            "type": "string",
            "description": "ID of the tweet to delete"
          }
        },
        "required": [
          "tweet_id"
        ]
      },
      "sample_input": {
        "tweet_id": "1445880548472328192"
      },
      "sample_output": {
        "data": {
          "deleted": true
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "deleted": {
                "type": "integer",
                "description": "The deleted"
              }
            },
            "description": "The data"
          }
        }
      }
    },
    {
      "service_name": "get_tweets",
      "description": "Get tweets by their IDs with expanded information",
      "service_type": "api_call",
      "endpoint_template": "/2/tweets",
      "request_config": {
        "method": "GET",
        "query_params_template": {
          "ids": "{{tweet_ids}}",
          "expansions": "author_id,attachments.media_keys,referenced_tweets.id",
          "tweet.fields": "created_at,public_metrics,lang,context_annotations,entities",
          "user.fields": "name,username,profile_image_url,verified"
        },
        "query_jinja": "{% if expansions %}{\"expansions\": {{ expansions | tojson }}}{% else %}{}{% endif %}"
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "tweet_ids": {
            "type": "string",
            "description": "Comma-separated list of tweet IDs (max 100)"
          },
          "expansions": {
            "type": "string",
            "description": "Comma-separated X expansions to return. Leave empty for the default: author_id,attachments.media_keys,referenced_tweets.id. Every expanded post or user is billed as a read, so name only what the flow uses (e.g. drop referenced_tweets.id when the replied-to / quoted posts are not read)."
          }
        },
        "required": [
          "tweet_ids"
        ]
      },
      "sample_input": {
        "tweet_ids": "1445880548472328192,1445880548472328193"
      },
      "sample_output": {
        "data": [
          {
            "id": "1445880548472328192",
            "text": "Hello world!",
            "created_at": "2024-10-07T09:00:00.000Z",
            "public_metrics": {
              "retweet_count": 10,
              "reply_count": 5,
              "like_count": 100,
              "quote_count": 2
            }
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id"
                },
                "text": {
                  "type": "string",
                  "description": "The text"
                },
                "created_at": {
                  "type": "string",
                  "description": "The created_at"
                },
                "public_metrics": {
                  "type": "object",
                  "properties": {
                    "retweet_count": {
                      "type": "integer",
                      "description": "Number of retweet_s"
                    },
                    "reply_count": {
                      "type": "integer",
                      "description": "Number of reply_s"
                    },
                    "like_count": {
                      "type": "integer",
                      "description": "Number of like_s"
                    },
                    "quote_count": {
                      "type": "integer",
                      "description": "Number of quote_s"
                    }
                  },
                  "description": "The public_metrics"
                }
              }
            },
            "description": "The data"
          }
        }
      },
      "response_config": {
        "usage": {
          "currency": "USD",
          "price_note": "X API pay-per-use list price (docs.x.com/x-api/getting-started/pricing, Oct 2026): $0.005 per post read and $0.010 per user read, counted per resource returned, including posts and users attached through expansions. X does not charge a resource again within the same UTC day, so these figures are an upper bound; your X developer console shows what was billed.",
          "meters": [
            {
              "meter": "post_read",
              "label": "Posts read",
              "unit": "post",
              "count": "data",
              "price": {
                "amount": 0.005,
                "per": 1
              }
            },
            {
              "meter": "post_read",
              "label": "Posts read",
              "unit": "post",
              "count": "includes.tweets",
              "price": {
                "amount": 0.005,
                "per": 1
              }
            },
            {
              "meter": "user_read",
              "label": "Users read",
              "unit": "user",
              "count": "includes.users",
              "price": {
                "amount": 0.01,
                "per": 1
              }
            }
          ]
        }
      }
    },
    {
      "service_name": "follow_user",
