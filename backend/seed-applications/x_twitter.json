    {
      "service_name": "get_home_timeline",
      "description": "Get home timeline tweets (tweets from accounts the user follows)",
      "service_type": "api_call",
      "endpoint_template": "/2/users/{{user_id}}/timelines/reverse_chronological",
      "request_config": {
        "method": "GET",
        "query_params_template": {
          "max_results": "{{max_results}}",
          "expansions": "author_id,attachments.media_keys",
          "tweet.fields": "created_at,public_metrics",
          "user.fields": "name,username,profile_image_url"
        },
        "query_jinja": "{% if expansions %}{\"expansions\": {{ expansions | tojson }}}{% else %}{}{% endif %}"
      },
