      "event_name": "tweet_created",
      "description": "Webhook for receiving real-time tweet creation events",
      "event_type": "webhook",
      "event_configuration": {
        "webhook_url": "{{webhook_url}}",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "validation": {
          "type": "challenge_response",
          "challenge_param": "crc_token",
          "response_field": "response_token",
          "signature_header": "X-Twitter-Webhooks-Signature",
          "signature_method": "HMACSHA256",
          "secret": "{{webhook_secret}}"
        },
        "retry_policy": {
          "max_retries": 3,
          "retry_on": [
            500,
            502,
            503,
            504
          ],
          "backoff_multiplier": 2
        }
