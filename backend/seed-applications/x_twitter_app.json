    {
      "service_name": "count_recent_tweets",
      "description": "Count tweets matching a query over the last 7 days, bucketed by minute/hour/day.",
      "service_type": "api_call",
      "endpoint_template": "/2/tweets/counts/recent",
      "request_config": {
        "method": "GET",
        "query_params_template": {
          "query": "{{query}}",
          "granularity": "{{granularity}}",
          "start_time": "{{start_time}}",
          "end_time": "{{end_time}}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "X search query"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "minute",
              "hour",
              "day"
            ],
            "default": "day"
          },
          "start_time": {
            "type": "string",
            "description": "ISO 8601 UTC"
          },
          "end_time": {
            "type": "string",
            "description": "ISO 8601 UTC"
          }
        },
        "required": [
          "query"
        ]
      },
      "sample_input": {
        "query": "@RBI -is:retweet",
        "granularity": "day"
      },
      "sample_output": {
        "data": [
          {
            "start": "2026-10-07T00:00:00.000Z",
            "end": "2026-10-08T00:00:00.000Z",
            "tweet_count": 412
          }
        ],
        "meta": {
          "total_tweet_count": 412
        }
      }
    }
  ],
  "events": [
    {
      "event_name": "new_search_results",
      "description": "New tweets matching the trigger's polling_overrides query, every 10 min, as a BATCH {items, includes, meta, count}; author location = includes.users[].location.",
      "event_type": "polling",
      "event_configuration": {
        "polling_service": "search_tweets",
        "interval_seconds": 600,
        "polling_parameters": {
          "max_results": 100
        },
        "pagination": {
          "token_path": "meta.next_token",
          "param": "next_token",
          "max_pages": 5
        },
        "change_detection": {
          "method": "new_items",
          "identifier_field": "id",
          "cursor_field": "id",
          "dispatch": "batch",
          "batch_size": 100
        }
      },
      "sample_payload": {
        "items": [
          {
            "id": "1445880548472328192",
            "text": "@RBI my bank has not refunded a failed UPI transfer",
            "created_at": "2026-10-07T09:00:00.000Z",
            "author_id": "2244994945",
            "lang": "en"
          }
        ],
        "includes": {
          "users": [
            {
              "id": "2244994945",
              "username": "someone",
              "location": "Pune, India"
            }
          ]
        },
        "meta": {
          "newest_id": "1445880548472328192",
          "result_count": 1
        },
        "count": 1
      },
      "usage_notes": "Set the search in the flow trigger's polling_overrides, e.g. {\"query\": \"(@RBI OR @FinMinIndia) -is:retweet\"}. Join items[].author_id to includes.users[].id for the author's location. Follows up to 5 pages per poll and resumes from the newest tweet id seen."
    }
  ],
  "metadata": {
    "created_at": "2026-10-28T20:29:17.785819",
