{
  "key": "x_twitter_app",
  "application": {
    "app_name": "X (Twitter) — App-only",
    "app_type": "api",
    "app_scope": "tenant",
    "description": "X API v2 with an app-only Bearer token: read-only search and lookup for unattended feeds (no user sign-in). Use the 'X (Twitter)' app to post or act as a user.",
    "category": "Communication",
    "auth_type": "api_key",
    "auth_config": {
      "header_name": "Authorization",
      "header_prefix": "Bearer",
      "description": "X app Bearer token (developer portal → your app → Keys and tokens)",
      "test_endpoint": "/2/usage/tweets"
    },
    "version": "1.1.0",
    "base_url": "https://api.twitter.com",
    "icon_url": "https://abs.twimg.com/responsive-web/client-web/icon-ios.77d25eba.png",
    "configuration_schema": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string",
          "title": "Bearer token",
          "description": "App-only Bearer token",
          "encrypted": true,
          "required": true
        }
      }
    }
  },
  "services": [
    {
      "service_name": "search_tweets",
      "description": "Search tweets from the last 7 days. Returns the author's profile location (includes.users[].location) and tagged places; page with next_token, resume with since_id.",
      "service_type": "api_call",
      "endpoint_template": "/2/tweets/search/recent",
      "request_config": {
        "method": "GET",
        "query_params_template": {
          "query": "{{query}}",
          "max_results": "{{max_results}}",
          "since_id": "{{since_id}}",
          "until_id": "{{until_id}}",
          "start_time": "{{start_time}}",
          "end_time": "{{end_time}}",
          "next_token": "{{next_token}}",
          "sort_order": "{{sort_order}}",
          "expansions": "author_id,geo.place_id,referenced_tweets.id",
          "tweet.fields": "created_at,author_id,lang,geo,public_metrics,entities,conversation_id,referenced_tweets,context_annotations",
          "user.fields": "name,username,location,description,verified,public_metrics,profile_image_url",
          "place.fields": "full_name,name,country,country_code,place_type,geo"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "X search query (max 512 characters), e.g. (@RBI OR @FinMinIndia OR @nsitharaman) -is:retweet lang:en"
          },
          "max_results": {
            "type": "integer",
            "description": "Results per page (10-100)",
            "default": 100,
            "minimum": 10,
            "maximum": 100
          },
          "since_id": {
            "type": "string",
            "description": "Only tweets newer than this tweet id"
          },
          "until_id": {
            "type": "string",
            "description": "Only tweets older than this tweet id"
          },
          "start_time": {
            "type": "string",
            "description": "Oldest UTC timestamp, ISO 8601 (YYYY-MM-DDTHH:mm:ssZ); at most 7 days ago"
          },
          "end_time": {
            "type": "string",
            "description": "Newest UTC timestamp, ISO 8601"
          },
          "next_token": {
            "type": "string",
            "description": "meta.next_token from the previous page"
          },
          "sort_order": {
            "type": "string",
            "enum": [
              "recency",
              "relevancy"
            ],
            "description": "Result order"
          }
        },
        "required": [
          "query"
        ]
      },
      "sample_input": {
        "query": "(@RBI OR @FinMinIndia) -is:retweet",
        "max_results": 100
      },
      "sample_output": {
        "data": [
          {
            "id": "1445880548472328192",
            "text": "@RBI my bank has not refunded a failed UPI transfer for 10 days",
            "created_at": "2026-10-07T09:00:00.000Z",
            "author_id": "2244994945",
            "lang": "en"
          }
        ],
        "includes": {
          "users": [
            {
              "id": "2244994945",
              "username": "someone",
              "name": "Some One",
              "location": "Pune, India"
            }
          ]
        },
        "meta": {
          "newest_id": "1445880548472328192",
          "oldest_id": "1445880548472328192",
          "result_count": 1,
          "next_token": "b26v89c19zqg8o3fo7"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "Matching tweets",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "author_id": {
                  "type": "string"
                },
                "lang": {
                  "type": "string"
                },
                "geo": {
                  "type": "object",
                  "description": "place_id when the author tagged a place (rare)"
                }
              }
            }
          },
          "includes": {
            "type": "object",
            "description": "Expanded objects: users (author location is users[].location, free text) and places",
            "properties": {
              "users": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    }
                  }
                }
              },
              "places": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "newest_id": {
                "type": "string"
              },
              "oldest_id": {
                "type": "string"
              },
              "result_count": {
                "type": "integer"
              },
              "next_token": {
                "type": "string"
              }
            }
          }
        }
      },
      "response_config": {
        "usage": {
          "currency": "USD",
          "price_note": "X API pay-per-use list price (docs.x.com/x-api/getting-started/pricing, Oct 2026): $0.005 per post read and $0.010 per user read, counted per resource returned, including posts and users attached through expansions. X does not charge a resource again within the same UTC day, so these figures are an upper bound; your X developer console shows what was billed.",
          "meters": [
            {
              "meter": "post_read",
              "label": "Posts read",
              "unit": "post",
              "count": "data",
              "price": {
                "amount": 0.005,
                "per": 1
              }
            },
            {
              "meter": "post_read",
              "label": "Posts read",
              "unit": "post",
              "count": "includes.tweets",
              "price": {
                "amount": 0.005,
                "per": 1
              }
            },
            {
              "meter": "user_read",
              "label": "Users read",
              "unit": "user",
              "count": "includes.users",
              "price": {
                "amount": 0.01,
                "per": 1
              }
            }
          ]
        }
      }
    },
