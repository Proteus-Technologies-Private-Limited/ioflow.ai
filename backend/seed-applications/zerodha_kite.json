    {
      "service_name": "place_order",
      "description": "Place an order of a particular variety (regular, amo, co, iceberg, auction) for equities, commodities, or currency derivatives.",
      "service_type": "api_call",
      "endpoint_template": "/orders/{{variety}}",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "X-Kite-Version": "3",
          "Authorization": "token {{api_key}}:{{access_token}}",
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "variety": {
            "type": "string",
            "description": "Order variety - regular, amo, co, iceberg, auction",
            "enum": [
              "regular",
              "amo",
              "co",
              "iceberg",
              "auction"
            ]
          },
          "tradingsymbol": {
            "type": "string",
            "description": "Trading symbol of the instrument (e.g., INFY, RELIANCE)"
          },
          "exchange": {
            "type": "string",
            "description": "Exchange to place the order on",
            "enum": [
              "NSE",
              "BSE",
              "NFO",
              "CDS",
              "BCD",
              "MCX",
              "BFO"
            ]
          },
          "transaction_type": {
            "type": "string",
            "description": "Transaction type - BUY or SELL",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "order_type": {
            "type": "string",
            "description": "Order type",
            "enum": [
              "MARKET",
              "LIMIT",
              "SL",
              "SL-M"
            ]
          },
          "quantity": {
            "type": "integer",
            "description": "Number of shares/lots to transact"
          },
          "product": {
            "type": "string",
            "description": "Margin product type",
            "enum": [
              "CNC",
              "NRML",
              "MIS"
            ]
          },
          "price": {
            "type": "number",
            "description": "Price for LIMIT orders"
          },
          "trigger_price": {
            "type": "number",
            "description": "Trigger price for SL and SL-M orders"
          },
          "disclosed_quantity": {
            "type": "integer",
            "description": "Quantity to disclose to the exchange"
          },
          "validity": {
            "type": "string",
            "description": "Order validity",
            "enum": [
              "DAY",
              "IOC",
              "TTL"
            ]
          },
          "validity_ttl": {
            "type": "integer",
            "description": "Order life span in minutes for TTL validity"
          },
          "tag": {
            "type": "string",
            "description": "Optional alphanumeric tag for the order (max 20 characters)"
          }
        },
        "required": [
          "variety",
          "tradingsymbol",
          "exchange",
          "transaction_type",
          "order_type",
          "quantity",
          "product"
        ]
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          }
        }
      }
    },
