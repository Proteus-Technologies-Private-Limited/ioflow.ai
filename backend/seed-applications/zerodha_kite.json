    {
      "service_name": "create_session_token",
      "description": "Exchange the request_token obtained after login for an access_token used to authenticate all subsequent API requests.",
      "service_type": "api_call",
      "endpoint_template": "/session/token",
      "request_config": {
        "method": "POST",
        "headers_template": {
          "X-Kite-Version": "3",
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "parameter_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "description": "The API key issued to your app"
          },
          "request_token": {
            "type": "string",
            "description": "The token received after the user completes the login flow"
          },
          "checksum": {
            "type": "string",
            "description": "SHA-256 hash of api_key + request_token + api_secret"
          }
        },
        "required": [
          "api_key",
          "request_token",
          "checksum"
        ]
      },
      "response_config": {
        "success_check": {
          "type": "status_code",
          "success_status_codes": [
            200
          ]
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "access_token": {
            "type": "string"
          },
          "public_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "login_time": {
            "type": "string"
          }
        }
      }
    },
