# IOFlow health monitor configuration.
#
# Copy to /etc/ioflow-healthcheck.env (or set HEALTHCHECK_ENV to this path) and
# edit. install_healthcheck.sh installs a copy here automatically if absent.
# All values have safe defaults baked into health_monitor.sh; only ALERT_RECIPIENTS
# really needs to be set.

# Absolute path to the deployed project root (contains backend/, logs/, scripts/).
# On the live server this is the systemd WorkingDirectory of ioflow.service.
PROJECT_DIR=/opt/ioflow

# systemd unit that runs the backend (used by the systemd profile and in alerts).
SERVICE_NAME=ioflow

# How to restart the backend when the health check fails.
#  - systemd host: leave commented (defaults to: systemctl restart $SERVICE_NAME)
#  - container / non-systemd host: the installer sets this to the restart script.
# IMPORTANT: the value MUST be quoted, otherwise sourcing this file would EXECUTE
# the command instead of assigning it. Correct form:
# RESTART_COMMAND="bash /opt/ioflow/scripts/restart_backend.sh"

# Daemon mode only (non-systemd hosts): seconds between checks.
CHECK_INTERVAL=30

# Local backend health endpoint (checked directly, bypassing nginx).
HEALTH_URL=http://127.0.0.1:7001/health

# Optional: also verify the public path through nginx. Leave empty to skip.
# A failure here with a healthy local backend points at nginx/TLS, not the app,
# so it alerts but does NOT trigger a backend restart.
PUBLIC_HEALTH_URL=

# curl timeouts (seconds). max-time must comfortably exceed a healthy response.
CONNECT_TIMEOUT=5
CURL_TIMEOUT=10

# Consecutive failures before the backend is considered down and restarted.
FAILURE_THRESHOLD=3

# Restart behaviour.
RESTART_ENABLED=true
# Minimum seconds between two automatic restarts (prevents restart storms /
# crash loops). systemd's own Restart=always still handles plain crashes.
RESTART_COOLDOWN=120

# Alerting. Comma-separated list. REQUIRED for email alerts to be sent.
ALERT_RECIPIENTS=ops@yourcompany.com
# Minimum seconds between repeated DOWN alerts while still down (anti-spam).
ALERT_MIN_INTERVAL=900

# Human-friendly label used in alert subjects (defaults to the machine hostname).
ALERT_HOSTNAME=
